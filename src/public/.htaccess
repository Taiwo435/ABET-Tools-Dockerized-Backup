Options -Indexes
Options -MultiViews

RewriteEngine On

# -------------------------------------------------
# Block spoofed headers that may be used to bypass 403 (ZAP: Bypassing 403)
# -------------------------------------------------
RewriteCond %{HTTP:X-Original-URL} . [OR]
RewriteCond %{HTTP:X-Rewrite-URL} .
RewriteRule ^ - [F]

# -------------------------------------------------
# Disable TRACE/TRACK methods to prevent proxy disclosure (ZAP: Proxy Disclosure)
# (leaving OPTIONS for CORS)
# -------------------------------------------------
RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
RewriteRule .* - [F]

# -------------------------------------------------
# Local env vars
# Will be overwritten by other Env vars on production
# -------------------------------------------------
SetEnv ABET_PRIVATE_DIR "/home/src/abet_private"
SetEnv ABET_PUBLIC_DIR "/var/www/html"

# uncomment to see values in case you want to set stuff based on this
# SetEnvIfNoCase Remote_Host "(.*)" HTTP_MY_REMOTE_HOST=$1 
# SetEnvIfNoCase Remote_Addr "(.*)" HTTP_MY_REMOTE_ADDR=$1
# SetEnvIfNoCase Server_Addr "(.*)" HTTP_MY_SERVER_ADDR=$1
# SetEnvIfNoCase Request_Method "(.*)" HTTP_MY_REQUEST_METHOD=$1
# SetEnvIfNoCase Request_Protocol "(.*)" HTTP_MY_REQUEST_PROTOCOL=$1
# SetEnvIfNoCase Request_URI "(.*)" HTTP_MY_REQUEST_URI=$1

# -------------------------------------------------
# allow direct access to assets only
# -------------------------------------------------
RewriteRule ^favicon\.ico$ /assets/img/favicon.ico [L]
#RewriteRule ^assets/(.*)$ /assets/$1 [R=301,L]

# RewriteRule ^.*\.json$ - [R=404,L]
# RewriteRule ^.*\.lock$ - [R=404,L]
# RewriteRule ^.*\.py$ - [R=404,L]

# -------------------------------------------------
# Symfony handles all files
# -------------------------------------------------

RewriteCond %{REQUEST_URI}::$1 ^(/.+)/(.*)::\2$
RewriteRule ^(.*) - [E=BASE:%1]

RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

RewriteRule ^index\.php - [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !^.+\.php$
RewriteRule ^ - [L]

RewriteRule ^ %{ENV:BASE}/index.php [L]


# -------------------------------------------------
# [IMPORTANT]
# .htaccess is NO LONGER used to route stuff!
# For pure php files, check `abet_private/src/LegacyBridge.php` to see new paths
#
# Else you can make a symfony route...
# -------------------------------------------------

