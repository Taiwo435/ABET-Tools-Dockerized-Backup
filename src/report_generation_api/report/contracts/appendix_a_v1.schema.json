{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abet.asucapstonetools.com/contracts/appendix-a/1.0",
  "title": "Appendix A Course Syllabi Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "courses"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "course_code",
          "course_name",
          "credits",
          "contact_hours",
          "credit_category",
          "delivery_type",
          "instructors",
          "catalog_description",
          "course_type",
          "specific_goals",
          "student_outcomes",
          "topics_covered"
        ],
        "properties": {
          "course_code": {
            "type": "string",
            "minLength": 1,
            "x-field-status": "Derived"
          },
          "course_name": {
            "type": "string",
            "minLength": 1,
            "x-field-status": "Required"
          },
          "credits": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-field-status": "Required"
          },
          "contact_hours": {
            "type": "string",
            "minLength": 1,
            "x-field-status": "Required"
          },
          "credit_category": {
            "type": "string",
            "minLength": 1,
            "x-field-status": "Required"
          },
          "delivery_type": {
            "type": "string",
            "enum": ["in_person", "online", "hybrid", "unspecified"],
            "x-field-status": "Missing from workflow"
          },
          "instructors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "x-field-status": "Required"
          },
          "textbooks": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "x-field-status": "Optional"
          },
          "catalog_description": {
            "type": "string",
            "minLength": 1,
            "x-field-status": "Required"
          },
          "prerequisites": {
            "type": "string",
            "x-field-status": "Optional"
          },
          "course_type": {
            "type": "string",
            "enum": ["R", "E", "SE"],
            "x-field-status": "Required"
          },
          "specific_goals": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "x-field-status": "Required"
          },
          "student_outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "x-field-status": "Required"
          },
          "topics_covered": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "x-field-status": "Required"
          }
        }
      }
    }
  }
}
