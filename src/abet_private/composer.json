{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "doctrine/doctrine-bundle": "^2.18.2",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/migrations": "^3.9.6",
        "doctrine/orm": "^3.6.2",
        "symfony/cache": "^7.4.7",
        "symfony/dotenv": "^7.4.7",
        "symfony/form": "^7.4.7",
        "symfony/framework-bundle": "^7.4.7",
        "symfony/http-kernel": "^7.4.7",
        "symfony/monolog-bundle": "^4.0.1",
        "symfony/runtime": "^7.4.1",
        "symfony/security-bundle": "^7.4.6",
        "symfony/stimulus-bundle": "^2.34",
        "symfony/translation": "^7.4.6",
        "symfony/twig-bundle": "^7.4.4",
        "symfony/ux-turbo": "^2.34",
        "symfony/validator": "^7.4.7",
        "symfony/yaml": "^7.4.6",
        "twig/extra-bundle": "^3.24",
        "vlucas/phpdotenv": "^5.6.3"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "symfony/debug-bundle": "^7.4.7",
        "symfony/maker-bundle": "^1.67",
        "symfony/profiler-pack": "^1.0",
        "symfony/test-pack": "^1.2",
        "symfony/web-profiler-bundle": "^7.4.7"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "scripts": {
        "doctrine": "./vendor/bin/doctrine-migrations",
        "pest": "./vendor/bin/pest",
        "test": "./bin/phpunit",
        "console": "./bin/console"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src",
            "Entity\\": "database/entities"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        },
        "runtime": {
            "dotenv_path": "../../docker/.env",
            "public-dir": "../public"
        }
    }
}
