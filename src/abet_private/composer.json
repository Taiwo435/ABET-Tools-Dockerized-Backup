{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "doctrine/migrations": "^3.9.6",
        "doctrine/orm": "^3.6.2",
        "symfony/cache": "^7.4.7",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/runtime": "^7.4",
        "symfony/security-bundle": "^7.4.6",
        "vlucas/phpdotenv": "^5.6.3"
    },
    "require-dev": {
        "pestphp/pest": "4.4.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "scripts": {
        "doctrine": "./vendor/bin/doctrine-migrations",
        "pest": "./vendor/bin/pest",
        "test": "./vendor/bin/pest",
        "console": "./bin/console"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Entity\\": "database/entities"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
