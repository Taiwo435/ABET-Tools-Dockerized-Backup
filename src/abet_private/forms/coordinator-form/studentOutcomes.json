{
  "title": "Student Outcomes",
  "name": "student_outcomes",
  "action": "submit.php",
  "method": "POST",
  "fields": [
    {
      "name": "student_outcomes_definition",
      "label": "Student Outcomes",
      "type": "text-field"
    },
    {
      "name": "relationship_to_peos",
      "label": "Relationship of Student Outcomes to Program Educational Objectives",
      "type": "text-field"
    },
    {
      "type": "expandable-grid",
      "name": "courses_and_methods_of_assessment",
      "label": "Courses and method of assessment for each outcome",
      "columns": [
        {
          "name": "abet_outcome",
          "label": "ABET Outcome",
          "type": "text"
        },
        {
          "name": "class_name",
          "label": "Class Name",
          "type": "text"
        },
        {
          "name": "assessment_method",
          "label": "Method of Assessment",
          "type": "text-field"
        }
      ],
      "maxRows": 50,
      "required": false
    },

    {
      "type": "section-break"
    },
    {
      "type": "expandable-grid",
      "name": "assessment_results_summary",
      "label": "Summary of assessment results",
      "columns": [
        {
          "name": "outcome",
          "label": "Outcome",
          "type": "text"
        },
        {
          "name": "summary",
          "label": "Summary of Assessment Results",
          "type": "text-field"
        }
      ],
      "maxRows": 10,
      "required": false
    },

    {
      "type": "section-break"
    },
    {
      "type": "expandable-grid",
      "name": "percentages_met_table",
      "label": "Table: Percentages of Met and Consecutive Not Met",
      "columns": [
        {
          "name": "outcome",
          "label": "Outcome",
          "type": "text"
        },
        {
          "name": "semesters_assessed",
          "label": "Semesters Assessed",
          "type": "text"
        },
        {
          "name": "percentage_met",
          "label": "Percentage Met",
          "type": "text"
        },
        {
          "name": "times_two_consecutive_semesters_not_met",
          "label": "Times of 2 Consecutive Semesters Not Met",
          "type": "text"
        },
        {
          "name": "percentage_met_past_year",
          "label": "Percentage Met in Past Year",
          "type": "text"
        }
      ],
      "maxRows": 10,
      "required": false
    }
  ]
