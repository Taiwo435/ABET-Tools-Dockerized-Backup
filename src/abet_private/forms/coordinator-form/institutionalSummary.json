{
  "title": "Institutional Summary",
  "name": "institutionalSummary",
  "action": "submit.php",
  "method": "POST",
  "fields": [
    {
      "type": "expandable-grid",
      "name": "program_enrollment_degree_data",
      "label": "Program Enrollment and Degree Data",
      "columns": [
        {
          "name": "academic_year",
          "label": "Academic Year",
          "type": "text"
        },
        {
          "name": "enrollment_status",
          "label": "Enrollment Status",
          "type": "select",
          "options": {
            "enrollment_ft": "Full Time Students (FT)",
            "enrollment_pt": "Part Time Students (PT)"
          }
        },
        {
          "name": "enrollment_1st",
          "label": "1st",
          "type": "text",
          "numerical": true
        },
        {
          "name": "enrollment_2nd",
          "label": "2nd",
          "type": "text",
          "numerical": true
        },
        {
          "name": "enrollment_3rd",
          "label": "3rd",
          "type": "text",
          "numerical": true
        },
        {
          "name": "enrollment_4th",
          "label": "4th",
          "type": "text",
          "numerical": true
        },
        {
          "name": "enrollment_5th",
          "label": "5th",
          "type": "text",
          "numerical": true
        },
        {
          "name": "total_undergrad",
          "label": "Total Undergrad",
          "type": "text",
          "numerical": true
        },
        {
          "name": "total_grad",
          "label": "Total Grad",
          "type": "text",
          "numerical": true
        },
        {
          "name": "degrees_associates",
          "label": "Associates",
          "type": "text",
          "numerical": true
        },
        {
          "name": "degrees_bachelors",
          "label": "Bachelors",
          "type": "text",
          "numerical": true
        },
        {
          "name": "degrees_masters",
          "label": "Masters",
          "type": "text",
          "numerical": true
        },
        {
          "name": "degrees_doctorates",
          "label": "Doctorates",
          "type": "text",
          "numerical": true
        }
      ],
      "maxRows": 20,
      "required": false
    },
    {
      "type": "expandable-grid",
      "name": "personnel",
      "label": "Personnel",
      "columns": [
        {
          "type": "text",
          "name": "category",
          "label": "Personnel Category"
        },
        {
          "type": "text",
          "name": "headcount_ft",
          "label": "Full-Time Head Count"
        },
        {
          "type": "text",
          "name": "headcount_pt",
          "label": "Part-Time Head Count"
        },
        {
          "type": "text",
          "name": "fte",
          "label": "Full-Time Equivalent"
        }
      ],
      "maxRows": 30,
      "required": false
    }
  ]
}