{

    "title": "Canvas Syllabus",
    "name": "canvasSyllabus",
    "action": "submit.php",
    "method": "POST",
    "fields": [
        {
            "type": "text",
            "name": "course_number",
            "label": "Course Number",
            "description": "The 3 letter prefix and 3 digit number of this course.",
            "required": true
        },
        {
            "type": "text",
            "name": "course_name",
            "label": "Course Name",
            "required": true
        },

        {
            "type": "text",
            "name": "instructor_coordinator_name",
            "label": "Instructor or Course Coordinator Name",
            "required": true
        },


        {
            "type": "section-break"
        },
        {
            "type": "section-label",
            "label": "Credits"
        },
        {
            "type": "select",
            "name": "credit_field",
            "label": "Subject Area",
            "description": "What subject area the course provide credits for.",
            "required": true,
            "options": {
                "math_science": "Math & Basic Sciences",
                "engineering_no_sig": "Engineering without Significant Design",
                "engineering_with_sd": "Engineering with Significant Design",
                "other": "Other"
            }
        },
        {
            "type": "text",
            "name": "credit_hours",
            "label": "Number of Credit Hours",
            "required": true,
            "numerical": true
        },



        {
            "type": "section-break"
        },
        {
            "type": "section-label",
            "label": "Course Textbook"
        },
        {
            "type": "select",
            "label": "Does this course use a textbook?",
            "options": {
                "yes": "Yes",
                "no": "No"
            },
            "required": true
        },
        {
            "type": "text",
            "name": "textbook_title",
            "label": "Textbook Title",
            "required": false
        },
        {
            "type": "text",
            "name": "textbook_author",
            "label": "Author",
            "required": false
        },
        {
            "type": "text",
            "name": "textbook_year",
            "label": "Year Released",
            "required": false,
            "numerical": true
        },


        {
            "type": "section-break"
        },
        {
            "type": "section-label",
            "label": "Specific Course Information"
        },
        {
            "type": "text-field",
            "name": "course_description",
            "label": "Catalog Description of the Course",
            "required": true
        },
        {
            "type": "text-field",
            "name": "pre_co_requisites_and_requirements",
            "label": "Prerequisites, Corequisites, and Other Requirements",
            "description": "e.g. 'CSE120 or EEE120 with C or better; CSE100, 110, or 200 with C or better; OR Computer Science or Computer Systems Engineering Graduate student; Credit is allowed for only CSE230 or EEE 230'",
            "required": true
        },
        {
            "type": "select",
            "name": "required_or_elective",
            "label": "Required or Elective?",
            "description": "Is this course a required course, an elective, or a selected elective within the program",
            "required": true,
            "options": {
                "required": "Required",
                "elective": "Elective",
                "selected_elective": "Selected Elective"
            }
        },


        {
            "type": "text-field",
            "name": "course_goals",
            "label": "Specific Goals for this Course",
            "required": true
        },
        {
            "type": "text-field",
            "name": "covered_topics",
            "label": "Brief list of topics to be covered",
            "required": true
        }
    ]
}