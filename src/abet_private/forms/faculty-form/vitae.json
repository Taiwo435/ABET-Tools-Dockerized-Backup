            "columns": [
                {
                    "name": "publication_or_presentation",
                    "label": "Publication or Presentation Citation",
                    "type": "text-field"
                }
            ],
            "maxRows": 10,
            "required": false
        },
        {
            "type": "expandable-grid",
            "name": "professional_development",
            "label": "Most Recent Professional Development Activities",
            "columns": [
                {
                    "name": "professional_development_activity",
                    "label": "Activity Name and Year(s)",
                    "type": "text"
                }
            ],
            "maxRows": 10,
            "required": false
