{

    "title": "Qualifications",
    "name": "qualifications",
    "action": "submit.php",
    "method": "POST",
    "fields": [
        {
            "type": "text",
            "name": "highest_degree_field",
            "label": "Highest Degree Earned: Field",
            "required": true
        },
        {
            "type": "text",
            "name": "highest_degree_year",
            "label": "Highest Degree Earned: Year",
            "required": true,
            "numerical": true
        },
        {
            "type": "text",
            "name": "rank",
            "label": "Rank",
            "required": true
        },
        {
            "type": "select",
            "name": "academic_appointment",
            "label": "Type of Academic Appointment",
            "required": true,
            "options": {
                "tenured": "Tenured (T)",
                "tenured_tracked": "Tenured Tracked (TT)",
                "non_tenured_tracked": "Non-Tenured Tracked (NTT)"
            }
        },
        {
            "type": "text",
            "name": "govt_ind_years_experience",
            "label": "Years of Experience in Government or Individual Practice",
            "required": true,
            "numerical": true
        },
        {
            "type": "text",
            "name": "teaching_years_experience",
            "label": "Years of Experience in Teaching",
            "required": true,
            "numerical": true
        },
        {
            "type": "text",
            "name": "asu_years_experience",
            "label": "Years of Experience at ASU",
            "required": true,
            "numerical": true
        },
        {
            "type": "expandable-grid",
            "name": "professional_reistrations_certifications",
            "label": "Professional Registrations and Certifications",
            "description": "Use abbreviations if possible",
            "columns": [
                {
                    "name": "registration_certification",
                    "label": "Registration/Certification",
                    "type": "text"
                }
            ],
            "maxRows": 10,
            "required": false
            
        },
        {
            "type": "expandable-grid",
            "name": "professional_organizations",
            "label": "Professional Organizations",
            "description": "Use abbreviations if possible",
            "columns": [
                {
                    "name": "organization",
                    "label": "Organization",
                    "type": "text"
                }
            ],
            "maxRows": 10,
            "required": false
            
        },
        {
            "type": "select",
            "name": "professional_development_level",
            "label": "Level of Professional Development",
            "required": true,
            "options": {
                "H": "High",
                "M": "Medium",
                "L": "Low"
            }
        },
        {
            "type": "select",
            "name": "consulting_summer_work_level",
            "label": "Amount of Consulting/Summer Work In the Industry",
            "required": true,
            "options": {
                "H": "High",
                "M": "Medium",
                "L": "Low"
            }
        }
    ]
}