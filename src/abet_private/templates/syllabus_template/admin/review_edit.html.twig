{% extends 'base.html.twig' %}

{% block title %}Review with Edits | {% endblock %}

{% block body %}
    <style>
        .review-edit { width: min(900px, calc(100% - 2rem)); margin: 2rem auto 4rem; }
        .review-edit__header { margin-bottom: 1rem; }
        .review-edit__header h1 { color: var(--asu-maroon); }
        .review-edit__notice { margin: 1rem 0; padding: 1rem; border-left: 5px solid var(--asu-gold); background: #fff7db; }
        .review-edit__notice--error { border-left-color: var(--error-red); background: #f8e1e5; color: var(--error-red); }
        .review-edit__form { padding: 1.5rem; border-radius: 8px; background: #fff; box-shadow: 0 10px 25px rgba(0, 0, 0, .08); }
        .review-edit__form > div { margin-bottom: 1rem; }
        .review-edit__form label { display: block; margin-bottom: .35rem; font-weight: 700; }
        .review-edit__form input, .review-edit__form textarea, .review-edit__form select { box-sizing: border-box; width: 100%; padding: .7rem; border: 1px solid #aaa; border-radius: 4px; font: inherit; }
        .review-edit__form textarea { min-height: 120px; }
        .review-edit__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.25rem; }
        .review-edit__form ul { color: var(--error-red); font-weight: 700; }
    </style>

    <section class="hero hero-small">
        <h1>Review {{ submission.commonCourse.courseSubject }} {{ submission.commonCourse.courseNumber }} with Edits</h1>
        <p>{{ submission.kind.value == 'faculty_offering' ? 'Correct syllabus content for this offering' : 'Correct course details and syllabus content' }} while preserving the frozen faculty-submitted revision.</p>
    </section>

    <main class="review-edit">
        <div class="review-edit__header">
            <h1>{{ submission.commonCourse.courseName }}</h1>
            <p>Seeded from faculty revision {{ submission.submittedRevision.revisionNumber }} submitted by {{ submission.submittedBy.asurite }}.</p>
        </div>

        <div class="review-edit__notice">Opening this page does not create a revision. A new immutable coordinator revision is saved only after meaningful, complete edits are submitted.</div>
        {% if sharedTemplateChanged %}<div class="review-edit__notice review-edit__notice--error" role="alert">This proposal is based on an older shared template. Approval is blocked until a separate reconciliation workflow is available.</div>{% endif %}

        {{ form_start(form, {attr: {class: 'review-edit__form'}}) }}
            {{ form_errors(form) }}
            {% if form.program is defined %}
                <h2>Course details</h2>
                {{ form_row(form.program) }}
                {{ form_row(form.courseSubject) }}
                {{ form_row(form.courseNumber) }}
                {{ form_row(form.courseName) }}
                {{ form_row(form.deliveryType) }}
            {% endif %}
            <h2>Syllabus content</h2>
            {{ form_row(form.creditHours) }}
            {{ form_row(form.courseCoordinators) }}
            {{ form_row(form.creditCategorization) }}
            {{ form_row(form.contactHours) }}
            {{ form_row(form.instructors) }}
            {{ form_row(form.textbooks) }}
            {{ form_row(form.catalogDescription) }}
            {{ form_row(form.prerequisites) }}
            {{ form_row(form.courseType) }}
            {{ form_row(form.specificGoals) }}
            {{ form_row(form.courseOutcomes) }}
            {{ form_row(form.studentOutcomes) }}
            {{ form_row(form.topicsCovered) }}
            <input type="hidden" name="_decision_token" value="{{ csrf_token('approve-with-edits-syllabus-submission-' ~ submission.id) }}">
            <div class="review-edit__actions">
                <button type="submit" class="button-primary"{% if sharedTemplateChanged %} disabled{% endif %}>Approve with edits</button>
                <a href="{{ path('app_admin_syllabus_template_review', {id: submission.id}) }}" class="button-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </main>
{% endblock %}
