{% extends 'base.html.twig' %}

{% block title %}Shared Syllabus Templates | {% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/assets/css/syllabus-lifecycle.css?v=20260727-5">
    <style>
        .syllabus-page { width: 100%; max-width: 1400px; margin: 2rem auto 3rem; padding: 0 1.25rem; }
        .syllabus-toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.25rem; padding: 1.25rem; background: var(--asu-white); border-radius: 8px; box-shadow: 0 8px 22px rgba(0, 0, 0, .07); }
        .syllabus-toolbar__actions { display: flex; flex-wrap: wrap; gap: .75rem; }
        .review-queue-link { display: inline-flex; align-items: center; gap: .5rem; }
        .review-count { display: inline-flex; align-items: center; justify-content: center; min-width: 1.5rem; height: 1.5rem; padding: 0 .35rem; border-radius: 999px; background: var(--asu-gold); color: #3b2a00; font-size: .78rem; font-weight: 800; line-height: 1; }
        .syllabus-filter { display: flex; flex-wrap: wrap; align-items: end; gap: .75rem; }
        .syllabus-filter label { display: grid; gap: .35rem; color: #444; font-size: .85rem; font-weight: 700; }
        .syllabus-filter select { min-width: 190px; padding: .65rem .75rem; border: 1px solid #b7b7b7; border-radius: 5px; background: var(--asu-white); font: inherit; }
        .syllabus-filter select:focus { outline: 3px solid rgba(255, 198, 39, .45); border-color: var(--asu-maroon); }
        .syllabus-table-wrap { overflow-x: auto; background: var(--asu-white); border-radius: 8px; box-shadow: 0 10px 25px rgba(0, 0, 0, .08); }
        .syllabus-table { width: 100%; min-width: 940px; border-collapse: collapse; }
        .syllabus-table th, .syllabus-table td { padding: .9rem 1rem; border-bottom: 1px solid #e6e6e6; text-align: left; }
        .syllabus-table th { background: var(--asu-maroon); color: var(--asu-white); font-size: .82rem; font-weight: 700; letter-spacing: .025em; }
        .syllabus-table tbody td { vertical-align: middle; }
        .syllabus-table tbody tr:hover { background: #fffaf0; }
        .syllabus-table tbody tr:last-child td { border-bottom: 0; }
        .course-code { color: var(--asu-maroon); font-size: 1rem; }
        .course-name, .cell-detail { color: #666; font-size: .88rem; }
        .template-state { display: inline-flex; align-items: center; gap: .45rem; font-weight: 600; }
        .completeness-icon { display: inline-flex; align-items: center; justify-content: center; width: 1.35rem; height: 1.35rem; border-radius: 50%; font-size: .9rem; font-weight: 800; line-height: 1; }
        .completeness-icon--complete { background: #d8f0df; color: #155b2d; }
        .completeness-icon--incomplete { background: #f9d7dc; color: #9f1d3f; }
        .missing-list { margin: 0; padding-left: 1.1rem; color: #5d4200; font-size: .88rem; }
        .missing-none { color: #39704a; font-weight: 600; }
        .publish-cell, .action-cell { text-align: center !important; vertical-align: middle !important; }
        .table-form { display: flex; justify-content: center; margin: 0; }
        .table-button { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 2.5rem; margin: 0; padding: .45rem .75rem; font-size: .82rem; line-height: 1.2; text-align: center; white-space: nowrap; }
        .table-action { color: var(--asu-maroon); font-weight: 700; text-decoration: none; }
        .table-action:hover { text-decoration: underline; text-underline-offset: 3px; }
        .empty-state { padding: 3rem 1.5rem; background: var(--asu-white); border-radius: 8px; box-shadow: 0 10px 25px rgba(0, 0, 0, .08); text-align: center; }
        .empty-state h2 { margin-bottom: .4rem; color: var(--asu-maroon); }
        .empty-state p { margin-bottom: 1.2rem; color: #666; }
        @media (max-width: 700px) {
            .syllabus-toolbar, .syllabus-filter { align-items: stretch; }
            .syllabus-toolbar > *, .syllabus-filter label, .syllabus-filter select { width: 100%; }
            .syllabus-toolbar__actions a { flex: 1; text-align: center; }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="hero hero-small">
        <h1>Shared Syllabus Templates</h1>
        <p>Create and maintain reusable course syllabus templates for faculty.</p>
    </section>

    <main class="syllabus-page">
        <div class="syllabus-context-card">
            <h2>Shared templates are reusable baselines</h2>
            <p>Publishing here updates the common-course template faculty can use. Faculty offering syllabi are reviewed separately and never replace this baseline.</p>
        </div>
        <div class="syllabus-lifecycle" aria-label="Shared template lifecycle">
            <div class="syllabus-lifecycle__step"><strong>1. Build baseline</strong><span>Enter reusable course and ABET content.</span></div>
            <div class="syllabus-lifecycle__step"><strong>2. Publish</strong><span>Make the approved revision available to faculty.</span></div>
            <div class="syllabus-lifecycle__step"><strong>3. Faculty offering</strong><span>Faculty create term-specific copies without changing the baseline.</span></div>
            <div class="syllabus-lifecycle__step"><strong>4. Report evidence</strong><span>Appendix A-ready revisions can cross the export boundary.</span></div>
        </div>
        <section class="syllabus-summary" aria-labelledby="syllabus-summary-title">
            <div class="syllabus-summary__header">
                <div>
                    <h2 id="syllabus-summary-title">Program syllabus status</h2>
                    {% if readinessProgram %}
                        <p>
                            Shared baselines, course offerings, and report readiness for
                            <strong>{{ readinessProgram.name }} ({{ readinessProgram.code }} — {{ readinessProgram.year }})</strong>.
                            Use the focused views below to act on this program.
                        </p>
                    {% else %}
                        <p>No programs are available for syllabus status reporting.</p>
                    {% endif %}
                </div>
                {% if readinessPrograms is not empty %}
                    <form method="get" action="{{ path('app_admin_syllabus_templates', {_fragment: 'syllabus-workspace'}) }}" class="syllabus-summary__program">
                        <label for="readiness-program">Program</label>
                        <select id="readiness-program" name="program" onchange="this.form.submit()">
                            {% for program in readinessPrograms %}
                                <option value="{{ program.program_id }}"{% if readinessProgram and program.program_id == readinessProgram.id %} selected{% endif %}>
                                    {{ program.program_name }} ({{ program.program_code }} — {{ program.program_year }})
                                </option>
                            {% endfor %}
                        </select>
                        <input type="hidden" name="view" value="{{ activeView }}">
                        {% if completenessFilter is not empty %}
                            <input type="hidden" name="completeness" value="{{ completenessFilter }}">
                        {% endif %}
                    </form>
                {% endif %}
            </div>

            {% if readinessProgram %}
                <div class="metrics-grid">
                    <div class="metric-card metric-card--static metric-all">
                        <span class="metric-number">{{ allTargetCount }}</span>
                        <span class="metric-label">All targets</span>
                        <span class="metric-sub">Shared baselines and course offerings</span>
                    </div>
                    <a href="{{ path('app_admin_syllabus_templates', {program: readinessProgram.id, view: 'appendix_a', _fragment: 'syllabus-workspace'}) }}" class="metric-card metric-ready">
                        <span class="metric-number">{{ reportReadyCount }}</span>
                        <span class="metric-label">Report ready</span>
                        <span class="metric-sub">Approved and Appendix A ready</span>
                    </a>
                    <a href="{{ path('app_admin_syllabus_templates', {program: readinessProgram.id, view: 'offerings', _fragment: 'pending-review'}) }}" class="metric-card metric-awaiting">
                        <span class="metric-number">{{ pendingReviewCount }}</span>
                        <span class="metric-label">Awaiting review</span>
                        <span class="metric-sub">Frozen faculty submissions</span>
                    </a>
                    <div class="metric-card metric-card--static metric-blocked">
                        <span class="metric-number">{{ readinessCounts['Blocked'] }}</span>
                        <span class="metric-label">Needs attention</span>
                        <span class="metric-sub">Preparation, correction, publication, or report evidence needed</span>
                    </div>
                    <div class="metric-card metric-card--static metric-missing">
                        <span class="metric-number">{{ readinessCounts['Missing'] }}</span>
                        <span class="metric-label">Missing target</span>
                        <span class="metric-sub">No shared template or no offering submission</span>
                    </div>
                </div>
            {% endif %}
        </section>

        {% if readinessProgram %}
            <nav id="syllabus-workspace" class="syllabus-workspace-tabs" aria-label="Syllabus workspace views">
                <a href="{{ path('app_admin_syllabus_templates', {program: readinessProgram.id, view: 'shared', _fragment: 'syllabus-workspace'}) }}"
                   class="{{ activeView == 'shared' ? 'active' : '' }}"
                   {% if activeView == 'shared' %}aria-current="page"{% endif %}>Shared templates</a>
                <a href="{{ path('app_admin_syllabus_templates', {program: readinessProgram.id, view: 'offerings', _fragment: 'syllabus-workspace'}) }}"
                   class="{{ activeView == 'offerings' ? 'active' : '' }}"
                   {% if activeView == 'offerings' %}aria-current="page"{% endif %}>
                    Course offerings &amp; review
                    {% if pendingReviewCount > 0 %}<span class="review-count">{{ pendingReviewCount }}</span>{% endif %}
                </a>
                <a href="{{ path('app_admin_syllabus_templates', {program: readinessProgram.id, view: 'appendix_a', _fragment: 'syllabus-workspace'}) }}"
                   class="{{ activeView == 'appendix_a' ? 'active' : '' }}"
                   {% if activeView == 'appendix_a' %}aria-current="page"{% endif %}>Appendix A readiness</a>
            </nav>
        {% endif %}

        {% if activeView == 'shared' %}
            <section class="workspace-panel" aria-labelledby="shared-view-heading">
                <div class="syllabus-toolbar">
                    <div>
                        <h2 id="shared-view-heading">Shared templates</h2>
                        <p>Manage the reusable baselines available to faculty in the selected program.</p>
                    </div>
                    <form method="get" action="{{ path('app_admin_syllabus_templates', {_fragment: 'syllabus-workspace'}) }}" class="syllabus-filter">
                        {% if readinessProgram %}<input type="hidden" name="program" value="{{ readinessProgram.id }}">{% endif %}
                        <input type="hidden" name="view" value="shared">
                        <label for="completeness">Publication readiness
                            <select id="completeness" name="completeness" onchange="this.form.submit()">
                                <option value=""{% if completenessFilter == '' %} selected{% endif %}>All publication states</option>
                                <option value="complete"{% if completenessFilter == 'complete' %} selected{% endif %}>Ready to publish</option>
                                <option value="incomplete"{% if completenessFilter == 'incomplete' %} selected{% endif %}>Needs publication fields</option>
                            </select>
                        </label>
                    </form>
                    <div class="syllabus-toolbar__actions">
                        <a href="{{ path('app_admin_panel') }}" class="button-secondary">Back to Admin Panel</a>
                        <a href="{{ path('app_admin_syllabus_templates_new', {program: readinessProgram.id}) }}" class="button-primary">Create Shared Template</a>
                    </div>
                </div>

                {% if templates is empty %}
                    <div class="empty-state">
                        <h2>No matching templates</h2>
                        <p>No shared templates in this program match the selected publication filter.</p>
                        <a href="{{ path('app_admin_syllabus_templates_new', {program: readinessProgram.id}) }}" class="button-primary">Create a shared template</a>
                    </div>
                {% else %}
                    <div class="syllabus-table-wrap">
                        <table class="syllabus-table">
                            <thead>
                                <tr><th>Course</th><th>Template state</th><th>Revision</th><th>Required before publishing</th><th>Updated</th><th>Action</th></tr>
                            </thead>
                            <tbody>
                            {% for template in templates %}
                                {% set revision = template.workingRevision %}
                                <tr>
                                    <td><strong class="course-code">{{ template.commonCourse.courseSubject }} {{ template.commonCourse.courseNumber }}</strong><div class="course-name">{{ template.commonCourse.courseName }}</div></td>
                                    <td>{% include 'syllabus_template/_lifecycle_badges.html.twig' with {submission: template, revision: revision, readinessMode: 'coordinator'} only %}</td>
                                    <td><strong>Rev. {{ revision.revisionNumber }}</strong></td>
                                    <td class="publish-cell">
                                        {% if revision.coordinatorPublicationBlockingFields is empty %}
                                            {% if template.status.value == 'draft' %}
                                                <form method="post" action="{{ path('app_admin_syllabus_templates_publish', {id: template.id}) }}" class="table-form">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('publish-syllabus-template-' ~ template.id) }}">
                                                    <button type="submit" class="button-primary table-button">Publish now</button>
                                                </form>
                                            {% else %}
                                                <span class="missing-none">Published{{ template.origin.value == 'faculty_submission' ? ' from faculty proposal' : '' }}</span>
                                            {% endif %}
                                        {% else %}
                                            <ul class="missing-list">
                                                {% for field in revision.coordinatorPublicationBlockingFields %}<li>{{ field|replace({'credits': 'Credit hours', 'course_coordinators': 'Course coordinator', 'credit_category': 'Credit categorization'}) }}</li>{% endfor %}
                                            </ul>
                                        {% endif %}
                                    </td>
                                    <td>{{ template.updatedAt|date('M j, Y') }}</td>
                                    <td class="action-cell">
                                        {% if template.status.value == 'draft' %}
                                            <a class="button-primary table-button" href="{{ path('app_admin_syllabus_templates_edit', {id: template.id}) }}">Edit draft</a>
                                        {% else %}
                                            <a href="{{ path('app_admin_syllabus_templates_edit', {id: template.id}) }}" class="button-primary table-button">Create new revision</a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        {% elseif activeView == 'offerings' %}
            <section class="workspace-panel" aria-labelledby="offerings-view-heading">
                <div class="workspace-panel__header">
                    <div><h2 id="offerings-view-heading">Course offerings &amp; review</h2><p>Review frozen faculty submissions and monitor every term-specific offering in this program.</p></div>
                    <div class="syllabus-toolbar__actions">
                        <a href="{{ path('app_admin_panel') }}" class="button-secondary">Back to Admin Panel</a>
                    </div>
                </div>

                <div id="pending-review" class="workspace-subsection">
                    <h3>Awaiting coordinator review <span class="review-count">{{ pendingReviewCount }}</span></h3>
                    {% if pendingSubmissions is empty %}
                        <p class="workspace-empty">No faculty submissions are waiting for review in this program.</p>
                    {% else %}
                        <div class="syllabus-table-wrap">
                            <table class="syllabus-table">
                                <thead><tr><th>Course</th><th>Target</th><th>Submitted by</th><th>Submitted</th><th>Action</th></tr></thead>
                                <tbody>
                                {% for submission in pendingSubmissions %}
                                    <tr>
                                        <td><strong class="course-code">{{ submission.commonCourse.courseSubject }} {{ submission.commonCourse.courseNumber }}</strong><div class="course-name">{{ submission.commonCourse.courseName }}</div></td>
                                        <td>
                                            <strong>{{ submission.kind.value == 'faculty_offering' ? 'Course offering' : 'Legacy shared-template proposal' }}</strong>
                                            {% if submission.courseOffering %}
                                                <div class="cell-detail">{{ submission.courseOffering.term }} {{ submission.courseOffering.academicYear }}{% if submission.courseOffering.section %}, section {{ submission.courseOffering.section }}{% endif %}</div>
                                            {% endif %}
                                        </td>
                                        <td><strong>{{ submission.submittedBy.asurite }}</strong><div class="cell-detail">{{ submission.submittedBy.email }}</div></td>
                                        <td>{{ submission.submittedAt|date('M j, Y g:i A') }}</td>
                                        <td><a href="{{ path('app_admin_syllabus_template_review', {id: submission.id}) }}" class="button-primary table-button">Review submission</a></td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>

                <div class="workspace-subsection">
                    <h3>All course offerings</h3>
                    {% if offeringRows is empty %}
                        <p class="workspace-empty">No term-specific faculty offerings exist for this program yet.</p>
                    {% else %}
                        <div class="syllabus-table-wrap">
                            <table class="syllabus-table">
                                <thead><tr><th>Course</th><th>Offering</th><th>Workflow</th><th>Submission readiness</th><th>Appendix A</th><th>Updated</th><th>Action</th></tr></thead>
                                <tbody>
                                {% for row in offeringRows %}
                                    <tr>
                                        <td><strong class="course-code">{{ row.courseCode }}</strong><div class="course-name">{{ row.courseTitle }}</div></td>
                                        <td><strong>{{ row.term }} {{ row.academicYear }}</strong><div class="cell-detail">Section {{ row.section is not empty ? row.section : '—' }} · {{ row.deliveryType|replace({'_': ' '})|title }}</div></td>
                                        <td><span class="syllabus-badge syllabus-badge--{{ row.workflowStatus.value }}">{{ row.workflowStatus.value|replace({'_': ' '})|title }}</span></td>
                                        <td>{{ row.facultySubmittable ? 'Ready to submit' : 'Submission fields missing' }}</td>
                                        <td>{{ row.appendixAReady ? 'Ready' : 'Evidence incomplete' }}</td>
                                        <td>{{ row.updatedAt ? row.updatedAt|date('M j, Y') : '—' }}</td>
                                        <td>
                                            {% if row.workflowStatus.value == 'submitted' %}
                                                <a href="{{ path('app_admin_syllabus_template_review', {id: row.syllabusId}) }}" class="button-primary table-button">Review</a>
                                            {% elseif row.workflowStatus.value in ['approved', 'approved_with_edits', 'denied'] %}
                                                <a href="{{ path('app_admin_syllabus_template_review', {id: row.syllabusId}) }}" class="button-secondary table-button">View record</a>
                                            {% else %}
                                                <span class="cell-detail">Faculty draft</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>

                <div id="review-history" class="workspace-subsection">
                    <h3>Completed reviews</h3>
                    {% if reviewedSubmissions is empty %}
                        <p class="workspace-empty">No completed faculty reviews exist for this program yet.</p>
                    {% else %}
                        <div class="syllabus-table-wrap">
                            <table class="syllabus-table">
                                <thead><tr><th>Course</th><th>Target</th><th>Decision</th><th>Reviewer</th><th>Decided</th><th>Feedback</th><th>Action</th></tr></thead>
                                <tbody>
                                {% for submission in reviewedSubmissions %}
                                    <tr>
                                        <td><strong class="course-code">{{ submission.commonCourse.courseSubject }} {{ submission.commonCourse.courseNumber }}</strong><div class="course-name">{{ submission.commonCourse.courseName }}</div></td>
                                        <td>
                                            <strong>{{ submission.kind.value == 'faculty_offering' ? 'Course offering' : 'Legacy shared-template proposal' }}</strong>
                                            {% if submission.courseOffering %}<div class="cell-detail">{{ submission.courseOffering.term }} {{ submission.courseOffering.academicYear }}{% if submission.courseOffering.section %}, section {{ submission.courseOffering.section }}{% endif %}</div>{% endif %}
                                        </td>
                                        <td><span class="syllabus-badge syllabus-badge--{{ submission.status.value }}">{{ submission.review.decision.value|replace({'_': ' '})|title }}</span></td>
                                        <td>{{ submission.review.reviewer.asurite }}</td>
                                        <td>{{ submission.decidedAt|date('M j, Y g:i A') }}</td>
                                        <td class="review-feedback">{{ submission.review.comment ?? '—' }}</td>
                                        <td><a href="{{ path('app_admin_syllabus_template_review', {id: submission.id}) }}" class="button-secondary table-button">View record</a></td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </section>
        {% else %}
            <section class="workspace-panel" aria-labelledby="appendix-view-heading">
                <div class="workspace-panel__header">
                    <div><h2 id="appendix-view-heading">Appendix A readiness</h2><p>Published shared baselines and approved course-offering syllabi may cross the report boundary when their Appendix A evidence is complete.</p></div>
                </div>

                <div class="workspace-subsection">
                    <h3>Shared baselines</h3>
                    {% if sharedAppendixTemplates is empty %}
                        <p class="workspace-empty">No published shared baselines are available for Appendix A reporting in this program.</p>
                    {% else %}
                        <div class="syllabus-table-wrap">
                            <table class="syllabus-table">
                                <thead><tr><th>Course</th><th>Publication</th><th>Report readiness</th><th>Required evidence</th><th>Action</th></tr></thead>
                                <tbody>
                                {% for template in sharedAppendixTemplates %}
                                    {% set revision = template.approvedRevision %}
                                    <tr>
                                        <td><strong class="course-code">{{ template.commonCourse.courseSubject }} {{ template.commonCourse.courseNumber }}</strong><div class="course-name">{{ template.commonCourse.courseName }}</div></td>
                                        <td><span class="syllabus-badge syllabus-badge--approved">Published shared baseline</span><div class="cell-detail">Revision {{ revision.revisionNumber }}</div></td>
                                        <td><span class="syllabus-badge syllabus-badge--{{ revision.appendixAReady ? 'ready' : 'attention' }}">{{ revision.appendixAReady ? 'Appendix A ready' : 'Evidence incomplete' }}</span></td>
                                        <td>
                                            {% if revision.appendixABlockingFields is empty %}
                                                <span class="missing-none">No blocking fields</span>
                                            {% else %}
                                                <ul class="missing-list">{% for field in revision.appendixABlockingFields %}<li>{{ field|replace({'_': ' '})|title }}</li>{% endfor %}</ul>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if revision.appendixAReady %}
                                                <a href="{{ path('app_admin_syllabus_template_appendix_a_export', {id: template.id}) }}" class="button-primary table-button">Download report-ready JSON</a>
                                            {% else %}
                                                <a href="{{ path('app_admin_syllabus_templates_edit', {id: template.id}) }}" class="button-primary table-button">Create revision</a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>

                <div class="workspace-subsection">
                    <h3>Course offerings</h3>
                    {% if appendixRows is empty %}
                        <p class="workspace-empty">No approved course-offering syllabi are available for Appendix A reporting in this program.</p>
                    {% else %}
                        <div class="syllabus-table-wrap">
                            <table class="syllabus-table">
                                <thead><tr><th>Course</th><th>Offering</th><th>Approval</th><th>Report readiness</th><th>Required evidence</th><th>Action</th></tr></thead>
                                <tbody>
                                {% for row in appendixRows %}
                                    <tr>
                                        <td><strong class="course-code">{{ row.courseCode }}</strong><div class="course-name">{{ row.courseTitle }}</div></td>
                                        <td><strong>{{ row.term }} {{ row.academicYear }}</strong><div class="cell-detail">Section {{ row.section is not empty ? row.section : '—' }} · {{ row.deliveryType|replace({'_': ' '})|title }}</div></td>
                                        <td><span class="syllabus-badge syllabus-badge--{{ row.workflowStatus.value }}">{{ row.workflowStatus.value|replace({'_': ' '})|title }}</span></td>
                                        <td><span class="syllabus-badge syllabus-badge--{{ row.appendixAReady ? 'ready' : 'attention' }}">{{ row.appendixAReady ? 'Appendix A ready' : 'Evidence incomplete' }}</span></td>
                                        <td>
                                            {% if row.appendixABlockingFields is empty %}
                                                <span class="missing-none">No blocking fields</span>
                                            {% else %}
                                                <ul class="missing-list">{% for field in row.appendixABlockingFields %}<li>{{ field|replace({'_': ' '})|title }}</li>{% endfor %}</ul>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if row.appendixAReady %}
                                                <a href="{{ path('app_admin_syllabus_template_appendix_a_export', {id: row.syllabusId}) }}" class="button-primary table-button">Download report-ready JSON</a>
                                            {% else %}
                                                <a href="{{ path('app_admin_syllabus_template_review', {id: row.syllabusId}) }}" class="button-secondary table-button">View record</a>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </section>
        {% endif %}
    </main>
{% endblock %}
