{% extends 'base.html.twig' %}

{% block title %}Syllabus Review History | {% endblock %}

{% block styles %}<link rel="stylesheet" href="/assets/css/syllabus-lifecycle.css">{% endblock %}

{% block body %}
    <style>
        .review-history { width: min(1180px, calc(100% - 2rem)); margin: 2rem auto 4rem; }
        .review-history__toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1rem; padding: 1rem; background: #fff; border-radius: 8px; }
        .review-history__filters { display: flex; flex-wrap: wrap; align-items: end; gap: .75rem; }
        .review-history__filters label { display: grid; gap: .3rem; font-weight: 700; }
        .review-history__filters select { min-width: 190px; padding: .6rem; }
        .review-history__table-wrap { overflow-x: auto; border-radius: 8px; background: #fff; box-shadow: 0 10px 25px rgba(0, 0, 0, .08); }
        .review-history table { width: 100%; min-width: 1100px; border-collapse: collapse; }
        .review-history th, .review-history td { padding: .8rem; border-bottom: 1px solid #ddd; text-align: left; vertical-align: top; }
        .review-history th { background: var(--asu-maroon); color: #fff; }
        .review-history__feedback { max-width: 280px; white-space: pre-wrap; }
        .review-history__empty { padding: 2rem; border-radius: 8px; background: #fff; text-align: center; }
    </style>

    <section class="hero hero-small">
        <h1>Completed Syllabus Reviews</h1>
        <p>Read-only decision history for reviewed faculty submissions.</p>
    </section>

    <main class="review-history">
        <div class="review-history__toolbar">
            <form method="get" class="review-history__filters">
                <label>Program
                    <select name="program">
                        <option value="0">All programs</option>
                        {% for program in programs %}<option value="{{ program.id }}"{% if selectedProgramId == program.id %} selected{% endif %}>{{ program.initials }} {{ program.year }}</option>{% endfor %}
                    </select>
                </label>
                <label>Decision
                    <select name="decision">
                        <option value="">All decisions</option>
                        {% for decision in decisions %}<option value="{{ decision.value }}"{% if selectedDecision == decision.value %} selected{% endif %}>{{ decision.value|replace({'_': ' '})|title }}</option>{% endfor %}
                    </select>
                </label>
                <button class="button-secondary" type="submit">Apply filters</button>
            </form>
            <a href="{{ path('app_admin_syllabus_template_reviews') }}" class="button-secondary">Pending Review Queue</a>
        </div>

        {% if reviewedSubmissions is empty %}
            <div class="review-history__empty"><h2>No completed reviews match these filters</h2><p>Completed faculty review decisions will appear here.</p></div>
        {% else %}
            <div class="review-history__table-wrap">
                <table>
                    <thead><tr><th>Course / Program</th><th>Faculty</th><th>Decision</th><th>Reviewer</th><th>Decided</th><th>Revisions</th><th>Feedback</th><th>Detail</th></tr></thead>
                    <tbody>
                    {% for submission in reviewedSubmissions %}
                        <tr>
                            <td><strong>{{ submission.commonCourse.courseSubject }} {{ submission.commonCourse.courseNumber }}</strong><br>{{ submission.commonCourse.program.initials }} {{ submission.commonCourse.program.year }}{% if submission.courseOffering %}<br><span class="cell-detail">{{ submission.courseOffering.term }} {{ submission.courseOffering.academicYear }}{% if submission.courseOffering.section %}, section {{ submission.courseOffering.section }}{% endif %}</span>{% endif %}{% include 'syllabus_template/_lifecycle_badges.html.twig' with {submission: submission, revision: submission.approvedRevision ?: submission.submittedRevision, readinessMode: 'faculty'} only %}</td>
                            <td>{{ submission.submittedBy.asurite }}</td>
                            <td>{{ submission.review.decision.value|replace({'_': ' '})|title }}</td>
                            <td>{{ submission.review.reviewer.asurite }}</td>
                            <td>{{ submission.decidedAt|date('M j, Y g:i A') }}</td>
                            <td>Submitted: {{ submission.submittedRevision.revisionNumber }}<br>Published: {{ submission.approvedRevision ? submission.approvedRevision.revisionNumber : 'None' }}</td>
                            <td class="review-history__feedback">{{ submission.review.comment ?? '—' }}</td>
                            <td><a href="{{ path('app_admin_syllabus_template_review', {id: submission.id}) }}">View record</a></td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </main>
{% endblock %}
