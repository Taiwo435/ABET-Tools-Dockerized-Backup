{% extends 'base.html.twig' %}

{% block title %}Faculty Syllabus Templates | {% endblock %}

{% block body %}
    <style>
        .faculty-syllabus { width: min(1050px, calc(100% - 2rem)); margin: 2rem auto 4rem; }
        .faculty-syllabus h1 { color: var(--asu-maroon); }
        .faculty-syllabus__section { margin-top: 1.5rem; padding: 1.25rem; background: #fff; border: 1px solid #ddd; border-radius: 6px; }
        .faculty-syllabus table { width: 100%; border-collapse: collapse; }
        .faculty-syllabus th, .faculty-syllabus td { padding: .75rem; border-bottom: 1px solid #ddd; text-align: left; }
        .faculty-syllabus th { background: var(--asu-maroon); color: #fff; }
        .faculty-syllabus form { margin: 0; }
        .faculty-draft-list { display: grid; gap: .8rem; padding: 0; list-style: none; }
        .faculty-draft-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: .8rem; border-bottom: 1px solid #ddd; }
        .faculty-draft-row:last-child { padding-bottom: 0; border-bottom: 0; }
        .faculty-draft-row__actions { display: flex; flex-wrap: wrap; align-items: start; gap: .75rem; }
    </style>

    <main class="faculty-syllabus">
        <h1>Faculty Syllabus Templates</h1>
        <p>Select an approved shared template to create your own independent working copy.</p>

        {% for type, messages in app.flashes %}
            {% for message in messages %}<p role="status" class="flash-{{ type }}">{{ message }}</p>{% endfor %}
        {% endfor %}

        {% if drafts is not empty %}
            <section class="faculty-syllabus__section">
                <h2>Your drafts</h2>
                <ul class="faculty-draft-list">
                    {% for draft in drafts %}
                        <li class="faculty-draft-row">
                            <div><strong>{{ draft.commonCourse.courseSubject }} {{ draft.commonCourse.courseNumber }}</strong> — {{ draft.commonCourse.courseName }}</div>
                            <div class="faculty-draft-row__actions">
                                <a class="button-secondary" href="{{ path('app_faculty_syllabus_templates_edit', {id: draft.id}) }}">Continue editing</a>
                                <form id="delete-faculty-draft-{{ draft.id }}" method="post" action="{{ path('app_faculty_syllabus_templates_delete', {id: draft.id}) }}" class="hold-delete-control">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-faculty-syllabus-' ~ draft.id) }}">
                                    <button type="button" class="hold-delete-button" data-hold-delete data-delete-form="delete-faculty-draft-{{ draft.id }}" aria-pressed="false" aria-describedby="delete-faculty-draft-warning-{{ draft.id }}">
                                        <span class="hold-delete-button__fill" aria-hidden="true"></span>
                                        <span class="hold-delete-button__label" data-hold-delete-label>Hold to delete</span>
                                    </button>
                                    <small id="delete-faculty-draft-warning-{{ draft.id }}" class="hold-delete-warning">Deletions are permanent.</small>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <section class="faculty-syllabus__section">
            <h2>Available shared templates</h2>
            {% if courses is empty %}
                <p>No approved shared syllabus templates are available yet.</p>
            {% else %}
                <table>
                    <thead><tr><th>Course</th><th>Program</th><th>Delivery</th><th>Action</th></tr></thead>
                    <tbody>
                    {% for course in courses %}
                        <tr>
                            <td><strong>{{ course.courseSubject }} {{ course.courseNumber }}</strong><br>{{ course.courseName }}</td>
                            <td>{{ course.program.name }}</td>
                            <td>{{ course.deliveryType.value|replace({'_': ' '})|title }}</td>
                            <td>
                                <a href="{{ path('app_faculty_syllabus_templates_use', {id: course.id}) }}" class="button-primary">Use template</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    </main>
    {% include 'syllabus_template/faculty/_hold_delete_behavior.html.twig' %}
{% endblock %}
