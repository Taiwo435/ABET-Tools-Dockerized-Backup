{% extends 'base.html.twig' %}

{% block title %}Faculty Syllabus Templates | {% endblock %}

{% block body %}
    <style>
        .faculty-syllabus { width: min(1050px, calc(100% - 2rem)); margin: 2rem auto 4rem; }
        .faculty-syllabus h1 { color: var(--asu-maroon); }
        .faculty-syllabus__section { margin-top: 1.5rem; padding: 1.25rem; background: #fff; border: 1px solid #ddd; border-radius: 6px; }
        .faculty-syllabus table { width: 100%; border-collapse: collapse; }
        .faculty-syllabus th, .faculty-syllabus td { padding: .75rem; border-bottom: 1px solid #ddd; text-align: left; }
        .faculty-syllabus th { background: var(--asu-maroon); color: #fff; }
        .faculty-syllabus form { margin: 0; }
        .faculty-draft-list { display: grid; gap: .8rem; padding: 0; list-style: none; }
        .faculty-draft-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: .8rem; border-bottom: 1px solid #ddd; }
        .faculty-draft-row:last-child { padding-bottom: 0; border-bottom: 0; }
        .faculty-draft-row__title { line-height: 1.5; }
        .faculty-draft-row__actions { display: flex; flex-wrap: wrap; align-items: start; gap: .75rem; }
        .completeness-icon { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 1.35rem; height: 1.35rem; margin-left: .25rem; border-radius: 50%; font-size: .9rem; font-weight: 800; line-height: 1; vertical-align: text-bottom; cursor: help; }
        .completeness-icon--complete { background: #d8f0df; color: #155b2d; }
        .completeness-icon--incomplete { background: #f9d7dc; color: #9f1d3f; }
        .completeness-icon::after { content: attr(data-tooltip); position: absolute; bottom: calc(100% + .55rem); left: 50%; z-index: 10; box-sizing: border-box; width: max-content; max-width: min(300px, 80vw); padding: .55rem .7rem; border-radius: 5px; background: #2f2f2f; color: #fff; font-size: .78rem; font-weight: 600; line-height: 1.35; text-align: left; white-space: normal; opacity: 0; pointer-events: none; transform: translate(-50%, .25rem); transition: opacity .15s ease, transform .15s ease; }
        .completeness-icon:hover::after, .completeness-icon:focus-visible::after { opacity: 1; transform: translate(-50%, 0); }
        .completeness-icon:focus-visible { outline: 3px solid rgba(255, 198, 39, .55); outline-offset: 2px; }
        .faculty-syllabus__toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
        .faculty-proposal-list { display: grid; gap: .65rem; padding: 0; list-style: none; }
        .faculty-proposal-list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; padding-bottom: .65rem; border-bottom: 1px solid #ddd; }
    </style>

    <main class="faculty-syllabus">
        <div class="faculty-syllabus__toolbar">
            <div>
                <h1>Faculty Syllabus Templates</h1>
                <p>Start with a blank syllabus or use an approved shared template.</p>
            </div>
            <a href="{{ path('app_faculty_syllabus_templates_new') }}" class="button-primary">Create blank draft</a>
        </div>

        {% for type, messages in app.flashes %}
            {% for message in messages %}<p role="status" class="flash-{{ type }}">{{ message }}</p>{% endfor %}
        {% endfor %}

        {% if drafts is not empty %}
            <section class="faculty-syllabus__section">
                <h2>Your drafts</h2>
                <ul class="faculty-draft-list">
                    {% for draft in drafts %}
                        {% set missingLabels = [] %}
                        {% for field in draft.workingRevision.missingFields %}
                            {% set missingLabels = missingLabels|merge([field|replace({'creditHours': 'Credit hours', 'courseCoordinators': 'Course coordinator', 'creditCategorization': 'Credit categorization'})]) %}
                        {% endfor %}
                        {% set completenessLabel = draft.workingRevision.complete ? 'Complete' : 'Incomplete — Missing: ' ~ missingLabels|join(', ') %}
                        <li class="faculty-draft-row">
                            <div class="faculty-draft-row__title">
                                <span><strong>{{ draft.commonCourse.courseSubject }} {{ draft.commonCourse.courseNumber }}</strong> — {{ draft.commonCourse.courseName }}</span>
                                <span
                                    class="completeness-icon completeness-icon--{{ draft.workingRevision.completenessStatus.value }}"
                                    role="img"
                                    tabindex="0"
                                    aria-label="{{ completenessLabel }}"
                                    data-tooltip="{{ completenessLabel }}"
                                >{{ draft.workingRevision.complete ? '✓' : '×' }}</span>
                            </div>
                            <div class="faculty-draft-row__actions">
                                <a class="button-secondary" href="{{ path('app_faculty_syllabus_templates_edit', {id: draft.id}) }}">Continue editing</a>
                                <form id="delete-faculty-draft-{{ draft.id }}" method="post" action="{{ path('app_faculty_syllabus_templates_delete', {id: draft.id}) }}" class="hold-delete-control">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-faculty-syllabus-' ~ draft.id) }}">
                                    <button type="button" class="hold-delete-button" data-hold-delete data-delete-form="delete-faculty-draft-{{ draft.id }}" aria-pressed="false" aria-describedby="delete-faculty-draft-warning-{{ draft.id }}">
                                        <span class="hold-delete-button__fill" aria-hidden="true"></span>
                                        <span class="hold-delete-button__label" data-hold-delete-label>Hold to delete</span>
                                    </button>
                                    <small id="delete-faculty-draft-warning-{{ draft.id }}" class="hold-delete-warning">Deletions are permanent.</small>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {% if proposals is not empty %}
            <section class="faculty-syllabus__section">
                <h2>Your submitted proposals</h2>
                <ul class="faculty-proposal-list">
                    {% for proposal in proposals %}
                        <li>
                            <span><strong>{{ proposal.commonCourse.courseSubject }} {{ proposal.commonCourse.courseNumber }}</strong> — {{ proposal.commonCourse.courseName }}</span>
                            <span>{{ proposal.status.value|replace({'_': ' '})|title }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <section class="faculty-syllabus__section">
            <h2>Available shared templates</h2>
            {% if courses is empty %}
                <p>No approved shared syllabus templates are available yet.</p>
            {% else %}
                <table>
                    <thead><tr><th>Course</th><th>Program</th><th>Delivery</th><th>Action</th></tr></thead>
                    <tbody>
                    {% for course in courses %}
                        <tr>
                            <td><strong>{{ course.courseSubject }} {{ course.courseNumber }}</strong><br>{{ course.courseName }}</td>
                            <td>{{ course.program.name }}</td>
                            <td>{{ course.deliveryType.value|replace({'_': ' '})|title }}</td>
                            <td>
                                <a href="{{ path('app_faculty_syllabus_templates_use', {id: course.id}) }}" class="button-primary">Use template</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    </main>
    {% include 'syllabus_template/faculty/_hold_delete_behavior.html.twig' %}
{% endblock %}
