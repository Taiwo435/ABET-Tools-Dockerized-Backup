{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }} | {% endblock %}

{% block body %}
    <style>
        .faculty-editor { width: min(850px, calc(100% - 2rem)); margin: 2rem auto 4rem; }
        .faculty-editor h1 { color: var(--asu-maroon); }
        .faculty-editor__summary, .faculty-editor__form { padding: 1.25rem; background: #fff; border: 1px solid #ddd; border-radius: 6px; }
        .faculty-editor__form { margin-top: 1rem; }
        .faculty-editor__form > div > div { display: grid; gap: .35rem; margin-bottom: 1rem; }
        .faculty-editor input, .faculty-editor textarea, .faculty-editor select { box-sizing: border-box; width: 100%; padding: .65rem; }
        .faculty-editor textarea { min-height: 7rem; }
        .faculty-editor__actions { display: flex; flex-wrap: wrap; align-items: flex-start; gap: .75rem; margin-top: 1rem; }
        .faculty-editor__actions > .button-primary,
        .faculty-editor__actions > .button-secondary,
        .faculty-editor__actions > .hold-delete-control { box-sizing: border-box; flex: 0 0 170px; width: 170px; }
        .faculty-editor__actions > .button-primary,
        .faculty-editor__actions > .button-secondary { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: .65rem .85rem; font-size: .95rem; line-height: 1.2; text-align: center; white-space: nowrap; }
        .faculty-editor__submit { margin-top: 1rem; padding: 1rem 1.25rem; background: #fffaf0; border: 1px solid #e1c36a; border-radius: 6px; }
        .faculty-editor__submit p { margin-top: 0; }
        .faculty-editor__submit form { margin: 0; }
        .faculty-editor__submit .button-primary:disabled { background: #aaa; cursor: not-allowed; }
    </style>

    <main class="faculty-editor">
        <h1>{{ pageTitle }}</h1>
        {% if course %}
            <div class="faculty-editor__summary">
                <strong>{{ course.courseName }}</strong><br>
                {{ course.program.name }} · {{ course.deliveryType.value|replace({'_': ' '})|title }}
                {% if submission and basedOnRevision %}
                    <p>This draft was copied from approved revision {{ basedOnRevision.revisionNumber }}. Later shared-template changes will not overwrite your work.</p>
                {% elseif basedOnRevision %}
                    <p>Preview and adjust approved revision {{ basedOnRevision.revisionNumber }}. Nothing is saved until you select “Create my draft” below.</p>
                {% else %}
                    <p>This is a blank faculty proposal. Course details and syllabus content remain editable until submission.</p>
                {% endif %}
            </div>
        {% else %}
            <div class="faculty-editor__summary">
                <p>Enter the common-course details and any syllabus content you have. Incomplete drafts can be saved and finished later.</p>
            </div>
        {% endif %}

        {% for type, messages in app.flashes %}
            {% for message in messages %}<p role="status" class="flash-{{ type }}">{{ message }}</p>{% endfor %}
        {% endfor %}

        {{ form_start(form, {attr: {class: 'faculty-editor__form'}}) }}
            {{ form_errors(form) }}
            {% if form.program is defined %}
                {{ form_row(form.program) }}
                {{ form_row(form.courseSubject) }}
                {{ form_row(form.courseNumber) }}
                {{ form_row(form.courseName) }}
                {{ form_row(form.deliveryType) }}
            {% endif %}
            {{ form_row(form.creditHours) }}
            {{ form_row(form.courseCoordinators) }}
            {{ form_row(form.creditCategorization) }}
            {{ form_row(form.catalogDescription) }}
            {{ form_row(form.courseOutcomes) }}
            <div class="faculty-editor__actions">
                <button type="submit" class="button-primary">{{ submission ? 'Save working copy' : (basedOnRevision ? 'Create my draft' : 'Create blank draft') }}</button>
                <a href="{{ path('app_faculty_syllabus_templates') }}" class="button-secondary">Back to templates</a>
                {% if submission %}
                    <div class="hold-delete-control">
                        <button type="button" class="hold-delete-button" data-hold-delete data-delete-form="delete-faculty-draft" aria-pressed="false" aria-describedby="delete-faculty-draft-warning">
                            <span class="hold-delete-button__fill" aria-hidden="true"></span>
                            <span class="hold-delete-button__label" data-hold-delete-label>Hold to delete</span>
                        </button>
                        <small id="delete-faculty-draft-warning" class="hold-delete-warning">Deletions are permanent.</small>
                    </div>
                {% endif %}
            </div>
        {{ form_end(form) }}

        {% if submission %}
            <form id="delete-faculty-draft" method="post" action="{{ path('app_faculty_syllabus_templates_delete', {id: submission.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-faculty-syllabus-' ~ submission.id) }}">
            </form>
            <section class="faculty-editor__submit">
                <p>{{ submission.workingRevision.complete ? 'This draft contains all required information and is ready for approval.' : 'Complete credit hours, at least one course coordinator, and credit categorization before submitting.' }}</p>
                <form method="post" action="{{ path('app_faculty_syllabus_templates_submit', {id: submission.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('submit-faculty-syllabus-' ~ submission.id) }}">
                    <button type="submit" class="button-primary"{% if not submission.workingRevision.complete %} disabled{% endif %}>Submit for approval</button>
                </form>
            </section>
        {% endif %}
    </main>
    {% include 'syllabus_template/faculty/_hold_delete_behavior.html.twig' %}
{% endblock %}
