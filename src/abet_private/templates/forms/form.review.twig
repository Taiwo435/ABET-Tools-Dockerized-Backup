{% extends 'base.html.twig' %}


{% block body %}
{% autoescape 'html' %}

<link rel="stylesheet" href="/assets/css/form.css">
<link rel="stylesheet" href="{{ reviewCssPath }}">

<div class="center-div">
  <div class="form-holder review-form-holder">
    <div class="top-bar">
      <h2 class="form-title">{{ reviewTitle }}</h2>
      <div class="page-select-actions">
        <button class="form-button form-button-return"
                type="button"
                onclick="window.location.assign('{{ formBasePath }}')">
          Return to Page Select
        </button>
      </div>
    </div>

    {# <?php foreach ($pageNames as $idx => $pageName): ?>
      <?php
        $pageNumber = $idx + 1;
        $form = loadFormPage($formName, $pageName);
        $saved = loadValues($pageName); // ignore this, $saved is passed in

        $title = $form["title"] ?? $pageName;
        $fields = $form["fields"] ?? [];
        $editLink = $formBasePath . "/edit/?page=" . urlencode((string)$pageNumber);
      ?>

      <div class="review-section">
        <div class="review-section-header">
          <div>
            <h3 class="form-label"><?php echo htmlspecialchars($title); ?></h3>
          </div>
          <button class="form-button form-button-save"
                  type="button"
                  onclick="window.location.assign('<?php echo htmlspecialchars($editLink); ?>')">
            Edit Section
          </button>
        </div> #}
    {% for pageName in pageNames %}
    {% set pageNumber = loop.index %}
    {% set form = loadFormPage(formName, pageName) %}
    {% set saved = loadValuesCoordinator(pageName)|default(null) %}

    {% set title = form.title|default(pageName) %}
    {% set fields = form.fields|default([]) %}
    {% set editLink = formBasePath ~ '/edit/?page=' ~ pageNumber|url_encode %}

    <div class="review-section">
        <div class="review-section-header">
            <div>
                <h3 class="form-label">{{ title }}</h3>
            </div>

            <button
                class="form-button form-button-save"
                type="button"
                onclick="window.location.assign('{{ editLink }}')"
            >
                Edit Section
            </button>
        </div>

        {# <?php foreach ($fields as $field): ?>
          <?php
            $type = $field["type"] ?? "";

            if ($type === "section-break") continue;

            $name = $field["name"] ?? "";
            if ($name === "" && $type !== 'section-label' && $type !== 'section-label-small') continue;

            $label = $field["label"] ?? "";
            $required = (bool)($field["required"] ?? false);
            $description = $field["description"] ?? "";
            $rawVal = $saved[$name] ?? null;

            if ($type === "select") {
              $key = is_string($rawVal) ? $rawVal : "";
              $opts = $field["options"] ?? [];
              $displayVal = ($key !== "" && isset($opts[$key])) ? $opts[$key] : $key;
            } else {
              $displayVal = formatReviewValue($rawVal);
            }
          ?>

          <div class="form-group">
            <label class="form-label">
              <?php echo htmlspecialchars($label); ?><?php if ($required) echo "*"; ?>
            </label>

            <?php if (!empty($description)): ?>
              <p class="form-field-description">
                <?php echo htmlspecialchars($description); ?>
              </p>
            <?php endif; ?>

            <?php if ($type === 'section-label' || $type === 'section-label-small'): ?>
              <!-- -->
            <?php elseif ($type === "expandable-grid"): ?>
              <?php
                $rows = decodeGridRows($rawVal);
                $cols = $field["columns"] ?? [];
              ?>

              <table class="review-grid">
                <thead>
                  <tr>
                    <?php foreach ($cols as $c): ?>
                      <th><?php echo htmlspecialchars($c["label"] ?? ($c["name"] ?? "Column")); ?></th>
                    <?php endforeach; ?>
                  </tr>
                </thead>
                <tbody>
                  <?php if (count($rows) === 0): ?>
                    <tr>
                      <td colspan="<?php echo htmlspecialchars((string)max(1, count($cols))); ?>">
                        <span class="review-empty">(empty)</span>
                      </td>
                    </tr>
                  <?php else: ?>
                    <?php foreach ($rows as $r): ?>
                      <tr>
                        <?php foreach ($cols as $c): ?>
                          <?php $cn = $c["name"] ?? ""; ?>
                          <td><?php echo htmlspecialchars(formatReviewValue($r[$cn] ?? "")); ?></td>
                        <?php endforeach; ?>
                      </tr>
                    <?php endforeach; ?>
                  <?php endif; ?>
                </tbody>
              </table>
            <?php else: ?>
              <div class="review-value-box">
                <?php if ($displayVal !== ""): ?>
                  <?php echo htmlspecialchars($displayVal); ?>
                <?php else: ?>
                  <span class="review-empty">(empty)</span>
                <?php endif; ?>
              </div>
            <?php endif; ?>

          </div>
        <?php endforeach; ?> #}
    {% for field in fields %}
        {% set type = field.type|default('') %}

        {% if type != 'section-break' %}

        {% set name = field.name|default('') %}

        {% if name != '' or type == 'section-label' or type == 'section-label-small' %}

            {% set label = field.label|default('') %}
            {% set required = field.required|default(false) %}
            {% set description = field.description|default('') %}
            {% set rawVal = saved[name]|default(null) %}

            {% if type == 'select' %}
                {% set key = rawVal|default('')%}
                {% set opts = field.options|default({}) %}

                {% if key != '' and opts[key] is defined %}
                    {% set displayVal = opts[key] %}
                {% else %}
                    {% set displayVal = key %}
                {% endif %}
            {% else %}
                {% set displayVal = formatReviewValue(rawVal) %}
            {% endif %}

            <div class="form-group">
                <label class="form-label">
                    {{ label }}{% if required %}*{% endif %}
                </label>

                {% if description %}
                    <p class="form-field-description">
                        {{ description }}
                    </p>
                {% endif %}

                {% if type == 'section-label' or type == 'section-label-small' %}
                    {# Intentionally empty #}

                {% elseif type == 'expandable-grid' %}

                    {% set rows = decodeGridRows(rawVal) %}
                    {% set cols = field.columns|default([]) %}

                    <table class="review-grid">
                        <thead>
                            <tr>
                                {% for c in cols %}
                                    <th>
                                        {{ c.label|default(c.name|default('Column')) }}
                                    </th>
                                {% endfor %}
                            </tr>
                        </thead>

                        <tbody>
                            {% if rows|length == 0 %}
                                <tr>
                                    <td colspan="{{ max(1, cols|length) }}">
                                        <span class="review-empty">(empty)</span>
                                    </td>
                                </tr>
                            {% else %}
                                {% for r in rows %}
                                    <tr>
                                        {% for c in cols %}
                                            {% set cn = c.name|default('') %}

                                            <td>
                                                {{ formatReviewValue(r[cn]|default('')) }}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>

                {% else %}

                    <div class="review-value-box">
                        {% if displayVal != '' %}
                            {{ displayVal }}
                        {% else %}
                            <span class="review-empty">(empty)</span>
                        {% endif %}
                    </div>

                {% endif %}
            </div>

            {% endif %}
        {% endif %}
    {% endfor %}

    {% endfor %}

      </div>
    <?php endforeach; ?>

    <div style="text-align: right;">
      <button class="form-button form-button-return"
              type="button"
              onclick="window.location.assign('{{ formBasePath }}')">
        Return to Page Select
      </button>
    </div>

  </div>
</div>
{% endautoescape %}
{% endblock %}