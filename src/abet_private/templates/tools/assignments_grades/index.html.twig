{# 
Maps to tool1.php 
#}
{% extends 'base.html.twig' %}

{% block title %}Enter API Key | {% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/assets/css/tool1/main.css">
{% endblock %}

{% block header_items %}
    <a href="{{ path('app_assignments_grades_jobs') }}">View Jobs</a>
{% endblock %}

{% block body %}

    <div class="main-container">
        
        <div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
            <div class="page-title">
                <h1>Connect to Canvas Class</h1>
                <p>Enter your Canvas Access Token</p>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin_panel') }}" class="btn btn-secondary">Back to Admin Panel</a>
            {% endif %}
        </div>

        <div>
            {{ form(form) }}
            <div class="form-help">Generate at Canvas → Account → Settings → Approved Integrations → New Access Token</div>
        </div>

        {% if (form_success ?? false) %}
            <div class="alert twig alert-success" id="successAlert">
                <div class="alert-content">
                    <strong>Successfully connected!</strong>
                    <div style="margin-top: 15px;">
                        <a href="{{ path('app_assignments_grades_new_extraction') }}" class="btn btn-primary">Continue to Select Courses →</a>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if app.session.has('canvas_token') and not (form_success ?? false) %}
            <div class="alert twig alert-success" id="successAlert">
                <div class="alert-content">
                    <strong>You have already registered a token with the site!</strong>
                    <div style="margin-top: 15px;">
                        <a href="{{ path('app_assignments_grades_remove_token') }}" class="btn btn-primary">Reset Canvas Access Token</a>
                        <a href="{{ path('app_assignments_grades_new_extraction') }}" class="btn btn-primary">Continue to Select Courses →</a>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if (form_error ?? false ) %}
            <div class="alert twig alert-error" id="errorAlert">
                <div class="alert-content">
                    <strong>Connection failed</strong>
                    <span id="errorMessage">{{ form_error }}</span>
                    <span id="errorMessage">{{ debug_error ?? null }}</span>
                </div>
            </div>
        {% endif %}

    <div class = "info-banner" style ="width: fit-content;">
        <span>Your token is used only to fetch your courses from Canvas. It is not stored permanently.</span>
    </div>
</div>

{% endblock %}
