{#
Maps to select-courses.php
#}
{% extends 'base.html.twig' %}
{% block title %}Select Course | {% endblock %}
{% block styles%}
  <link rel="stylesheet" href="/assets/css/tool1/main.css">
  <link rel="stylesheet" href="/assets/css/tool1/new_extraction.css">
  <style>
    #next-btn:disabled {
      background-color: #ccc;
      color: #888;
      cursor: not-allowed;
      border-color: #ccc;
    }
  </style>
{% endblock %}
{% block header_items %}
    <a href="{{ path('app_assignments_grades_jobs') }}">See Extraction Jobs</a>
    <a href="{{ path('app_assignments_grades_remove_token') }}">Remove Token</a>
{% endblock %}
{% block body %}
<div class="main-container">
<div class="page-header" style = "display: flex; justify-content: space-between; align-items: center;">
    <div class="page-title">
        <h1>Add Canvas Classes</h1>
        <p>Select one class to work with</p>
    </div>
</div>
<div class="filter-bar">
    <div class="filter-group">
        <label class="filter-label">Destination</label>
        <!-- TODO(Admin Settings):
            Currently, the destination course IDs for CS and CSE are hardcoded placeholders.
            In the future, fetch these from the admin portal settings. -->
        <select id="programFilter" class="filter-select">
        <option id="cse-option" value="CSE" data-dest-id="240102" selected>Computer Systems Engineering (CSE)</option>
        <option id="cs-option" value="CS" data-dest-id="240102">Computer Science (CS)</option>
        </select>
    </div>
    </div>
    <div id="selection-bar">
        <button class="btn btn-primary" id="next-btn" disabled>Go to Assignments →</button>
    </div>
    <label style="display: none; color: var(--warning); padding: 10px; font-weight: bold; text-align: center;" id="warning_next_page">Select a class first</label>
    <div class="classes-grid" id="classesGrid">
    </div>
    {% if not (app.session.has('canvas_token')) %}
    <div class="alert alert-error" id="errorAlert">
        <div class="alert-content">
        <strong>Warning:</strong>
        <span id="errorMessage">No canvas token detected!
            <br/>
            <a href="{{ path('app_assignments_grades') }}">Submit new Canvas Token here:</a>
        </span>
        </div>
    </div>
    {% endif %}
    {% if error ?? false %}
    <div class="alert alert-error" id="errorAlert">
        <div class="alert-content">
        <strong>Error:</strong>
        <span id="errorMessage">{{error}}</span>
        </div>
    </div>
    {% endif %}
</div>
<script>
    // Courses are loaded server-side and passed directly -- no term/
    // semester selection step: load everything the token has access to
    // at once, identified by Canvas course ID. Selection is single-only:
    // pick one class, then proceed to its assignments.
    const initialCourses = {{ courses|default([])|json_encode|raw }};
    const courses = {}
    const assignmentsBaseUrl = "{{ path('app_assignments_grades_assignments') }}";
    let selectedCourseCode = null;

    function showError(msg) {
        const errorAlert = document.getElementById('errorAlert');
        if (!errorAlert) return;
        errorAlert.style.display = 'block'
        document.getElementById('errorMessage').textContent =
            typeof msg === 'string' ? msg : JSON.stringify(msg)
        errorAlert.scrollIntoView({ behavior: 'smooth' })
    }

    function createClassHeader(course)
    {
        const class_header_div = document.createElement('div')
        class_header_div.className = "class-header"
        const class_code_div = document.createElement('div')
        class_code_div.className = "class-code"
        class_code_div.textContent = course['course_code']
        const class_title_h3 = document.createElement('h3')
        class_title_h3.className = "class-header"
        class_title_h3.textContent = course['name']
        const class_meta_div = document.createElement('div')
        class_meta_div.className = "class-meta";
        const semester_badge_span = document.createElement('span')
        semester_badge_span.className = "semester-badge"
        semester_badge_span.textContent = (course['term'] && course['term']['name']) || ''
        class_header_div.appendChild(class_code_div)
        class_header_div.appendChild(class_title_h3)
        class_meta_div.appendChild(semester_badge_span)
        class_header_div.append(class_meta_div)
        return class_header_div
    }

    function createClassBody(course)
    {
        const class_body_div = document.createElement('div')
        class_body_div.className = "class-body"
        const class_info_grid_div = document.createElement('div')
        class_info_grid_div.className = "class-info-grid"
        class_info_grid_div.style.gridTemplateColumns = "1fr";
        const info_item_div = document.createElement('div')
        const info_label_div = document.createElement('div')
        const info_value_div = document.createElement('div')
        info_item_div.className = "info-item"
        info_label_div.className = "info-label"
        info_label_div.textContent = "Instructor"
        info_value_div.className = "info-value"
        let instructorName = "";
        if (course.teachers && course.teachers.length > 0) {
            instructorName = course.teachers.map(t => t.display_name || t.name).join(", ");
        }
        info_value_div.textContent = instructorName;
        info_item_div.append(info_label_div, info_value_div)
        class_info_grid_div.appendChild(info_item_div)
        class_body_div.appendChild(class_info_grid_div)
        return class_body_div
    }

        function selectCard(card, courseCode) {
        const nextBtn = document.getElementById('next-btn');
        if (selectedCourseCode === courseCode) {
            card.classList.remove('selected-card');
            selectedCourseCode = null;
            if (nextBtn) nextBtn.disabled = true;
            return;
        }
        document.querySelectorAll('.class-card').forEach(c => c.classList.remove('selected-card'));
        card.classList.add('selected-card');
        selectedCourseCode = courseCode;
        if (nextBtn) nextBtn.disabled = false;
    }

    function renderCourses(courseList) {
        const grid_classes = document.getElementById('classesGrid')
        grid_classes.innerHTML = "";
        const selectionBar = document.getElementById('selection-bar');
        if (!courseList || courseList.length === 0) {
            if (selectionBar) selectionBar.style.display = "none";
            const warning_text = document.getElementById('warning_next_page')
            if (warning_text) {
                warning_text.textContent = "No classes found for this token."
                warning_text.style.display = "block"
            }
            return;
        }
        if (selectionBar) selectionBar.style.display = "flex";

        for (let i = 0; i < courseList.length; i++) {
            courses[courseList[i].course_code] = courseList[i];
            const class_card_div = document.createElement('div');
            class_card_div.className = "class-card"
            class_card_div.append(createClassHeader(courseList[i]))
            class_card_div.append(createClassBody(courseList[i]))
            class_card_div.addEventListener('click', function() {
                selectCard(class_card_div, courseList[i].course_code);
            });
            grid_classes.append(class_card_div)
        }
    }

    // NOTE: this goes straight to Assignments, skipping roster upload
    // for now. Roster upload is NOT removed from the plan 
    // it still needs to happen between course selection and assignments
    // eventually (this is where the old legacy api-proxy.php /
    // course-setup.php / sessionStorage logic used to live before this
    // rework).
    document.getElementById('next-btn').addEventListener('click', function() {
        if (!selectedCourseCode || !courses[selectedCourseCode]) {
            const warning_text = document.getElementById('warning_next_page')
            if (warning_text) warning_text.style.visibility = "visible"
            return;
        }
        const selectedCourse = courses[selectedCourseCode];
        window.location.href = assignmentsBaseUrl + '?courseId=' + encodeURIComponent(selectedCourse.id);
    });

    renderCourses(initialCourses.courses || initialCourses);
</script>
{% endblock %}
