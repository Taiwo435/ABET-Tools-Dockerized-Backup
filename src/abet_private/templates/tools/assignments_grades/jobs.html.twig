{% extends 'base.html.twig' %}

{% block title %}Job History | {% endblock %}

{% block styles%}
  <link rel="stylesheet" href="/assets/css/tool1/main.css">
  <link rel="stylesheet" href="/assets/css/tool1/jobs.css">
{% endblock %}

{% block header_items %}
  <a href="{{ path('app_assignments_grades_new_extraction') }}">New Extraction</a>
  <a href="{{ path('app_assignments_grades_remove_token') }}">Remove Token</a>
{% endblock %}


{% block body %}

  <div class="main-container">

    <div class="page-header">
      <div class="page-title">
        <h1>Your Extraction Jobs</h1>
        <p>Recent extraction and formatting jobs</p>
      </div>
    </div>

    <div class="page-actions">
      <span id="lastUpdated" style="font-size:0.8rem;color:var(--text-light)"></span>
      <button class="refresh-btn" onclick="window.location.reload();">↻ Refresh</button>
    </div>

    {# {{ jobs }} #}

    <div class="card">
      <div class="card-body" style="padding:0" id="jobsContainer">
      {# normal flow, no jobs #}
        {% if jobs|length == 0 %}
          <div class="empty-state">
            <h3>No jobs yet</h3>
            <p>Start an extraction from the <a href="{{ path('app_assignments_grades_new_extraction') }}">Extract Courses</a></p>
          </div>
        {% else %}
          {# Jobs are active: render them! #}

          <table class="jobs-table">
            <thead>
              <tr>
                <th>Course</th>
                <th>Status</th>
                <th>Message</th>
                <th>Started</th>
              </tr>
            </thead>
            <tbody>
            {# EACH JOB ENTRY #}
            {% for job in jobs %}
            <tr>
            {# I'm sorry, but I don't want to reverse engineer this right now. #}

              <td><strong>{{ job.params.course_name ?? "No Name" }}</strong></td>
              <td><div class="progress-mini"><div class="progress-mini-fill" style="width:{{job.progress}}%"></div></div></td>
              <td style="color:var(--text-light);font-size:0.85rem;max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{job.message}}</td>
              {% if job.status == 'failed' %}
              <td style="color:var(--text-light);font-size:0.85rem;max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{job.error_message}}</td>
              {% endif %}
              <td style="font-size:0.85rem;color:var(--text-light)">${timeAgo(j.created_at)}</td>
            </tr>
            {% endfor %}
            </tbody>
          </table>

          <div class="empty-state">
            <h3>job recieved!</h3>
            <p>Start an extraction from the <a href="{{ path('app_assignments_grades_new_extraction') }}">Extract Courses</a></p>
          </div>
        {% endif %}
        {# ABNORMAL FLOW, ERROR #}
        {% if error ?? false %}
          <div class="empty-state">
            <h3>An error has occured.</h3>
            <p>Please contact support and send this error message: {{error}}</p>
          </div>
        {% endif %}
      </div>
    </div>

    <script>
    </script>

  </div>

{% endblock %}
