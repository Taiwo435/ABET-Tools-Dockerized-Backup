{% extends 'base.html.twig' %}
{% import _self as readiness %}

{% macro purpose(isReady, blockingFields, readyLabel, blockedLabel) %}
    <div class="purpose-cell">
        <span class="readiness-pill {{ isReady ? 'readiness-pill--ready' : 'readiness-pill--blocked' }}">
            {{ isReady ? readyLabel : blockedLabel }}
        </span>
        {% if not isReady and blockingFields is not empty %}
            <div class="tags-container">
                {% for field in blockingFields %}
                    <span class="field-tag">{{ field|replace({
                        '_': ' ',
                        'credits': 'credit hours',
                        'course coordinators': 'course coordinators',
                        'credit category': 'credit category',
                        'contact hours': 'contact hours',
                        'catalog description': 'catalog description',
                        'course type': 'course type',
                        'specific goals': 'specific goals',
                        'student outcomes': 'student outcomes',
                        'topics covered': 'topics covered'
                    })|title }}</span>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endmacro %}

{% block title %}Program Syllabus Readiness | {% endblock %}

{% block styles %}
    <link rel="stylesheet" href="/assets/css/readiness.css?v=20260727">
{% endblock %}

{% block body %}
{% autoescape 'html' %}
    {% set has_advanced_filters =
        active_filters.target is not empty
        or active_filters.workflow is not empty
        or active_filters.faculty is not empty
        or active_filters.coordinator is not empty
        or active_filters.appendix_a is not empty
    %}

    <div class="site-header">
        <div class="site-title">ABET Tools — Program Syllabus Readiness</div>
    </div>

    <main class="readiness-container">
        <section class="readiness-hero">
            <div class="hero-content">
                <h1>Syllabus lifecycle overview</h1>
                <p class="subtitle">
                    Shared-template publication, offering workflow, and report readiness for
                    <strong>{{ program.program_name }} ({{ program.program_code }} — {{ program.program_year }})</strong>
                </p>
            </div>
            {% if programs is not empty %}
                <div class="program-selector-container">
                    <label for="program-selector" class="program-label">Program</label>
                    <select id="program-selector" class="program-select">
                        {% for prog in programs %}
                            <option value="{{ prog.program_id }}" {% if prog.program_id == program_id %}selected{% endif %}>
                                {{ prog.program_name }} ({{ prog.program_code }} — {{ prog.program_year }})
                            </option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
        </section>

        <section class="readiness-context" aria-label="Readiness definitions">
            <div><strong>Faculty submission</strong><span>Fields required to freeze and submit an offering-specific syllabus.</span></div>
            <div><strong>Shared publication</strong><span>Fields required to publish the reusable common-course baseline.</span></div>
            <div><strong>Appendix A</strong><span>Additional evidence required after approval for report-ready export.</span></div>
        </section>

        <form method="get" action="{{ path('app_program_readiness', {programId: program_id}) }}" class="readiness-filter-panel">
            <div class="filter-field">
                <label for="category-filter">Overview category</label>
                <select id="category-filter" name="category">
                    <option value="">All categories</option>
                    {% for category in ['Ready', 'Blocked', 'Awaiting review', 'Missing'] %}
                        <option value="{{ category }}" {% if active_filters.category == category %}selected{% endif %}>{{ category }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="filter-field">
                <label for="target-filter">Target</label>
                <select id="target-filter" name="target">
                    <option value="">All targets</option>
                    <option value="shared_template" {% if active_filters.target == 'shared_template' %}selected{% endif %}>Shared template</option>
                    <option value="course_offering" {% if active_filters.target == 'course_offering' %}selected{% endif %}>Course offering</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="workflow-filter">Offering workflow</label>
                <select id="workflow-filter" name="workflow">
                    <option value="">All workflow states</option>
                    {% for status in workflow_statuses %}
                        <option value="{{ status.value }}" {% if active_filters.workflow == status.value %}selected{% endif %}>
                            {{ status.value|replace({'_': ' '})|title }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            {% for parameter, label in {
                faculty: 'Faculty submission',
                coordinator: 'Shared publication',
                appendix_a: 'Appendix A'
            } %}
                <div class="filter-field">
                    <label for="{{ parameter }}-filter">{{ label }}</label>
                    <select id="{{ parameter }}-filter" name="{{ parameter }}">
                        <option value="">Any readiness</option>
                        <option value="ready" {% if active_filters[parameter] == 'ready' %}selected{% endif %}>Ready</option>
                        <option value="blocked" {% if active_filters[parameter] == 'blocked' %}selected{% endif %}>Blocked</option>
                    </select>
                </div>
            {% endfor %}
            <div class="filter-actions">
                <button type="submit" class="btn-filter">Apply filters</button>
                <a href="{{ path('app_program_readiness', {programId: program_id}) }}" class="btn-clear">Clear</a>
            </div>
        </form>

        <section class="table-card">
            <div class="table-header">
                <h2>Syllabus targets <span class="badge-count">{{ rows|length }}</span></h2>
                {% if active_filter is not empty or has_advanced_filters %}
                    <a href="{{ path('app_program_readiness', {programId: program_id}) }}" class="btn-clear">Clear all filters ×</a>
                {% endif %}
            </div>

            <div class="table-responsive">
                <table class="readiness-table">
                    <thead>
                        <tr>
                            <th>Course</th>
                            <th>Target</th>
                            <th>Lifecycle</th>
                            <th>Faculty submission</th>
                            <th>Shared publication</th>
                            <th>Appendix A</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if rows is empty %}
                            <tr>
                                <td colspan="7" class="empty-state">
                                    <div class="empty-state-content">
                                        <h3 class="empty-title">No matching syllabus targets</h3>
                                        <p class="empty-subtitle">No shared templates or course offerings match the selected filters.</p>
                                        <a href="{{ path('app_program_readiness', {programId: program_id}) }}" class="btn-clear-filter">Reset filters</a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            {% for row in rows %}
                                {% set category = row.state.getCategory() %}
                                <tr>
                                    <td class="course-cell">
                                        <span class="course-code">{{ row.courseCode }}</span>
                                        <span class="course-title">{{ row.courseTitle }}</span>
                                    </td>
                                    <td class="target-cell">
                                        {% if row.courseOfferingId %}
                                            <strong>Course offering</strong>
                                            <span>{{ row.term }} {{ row.academicYear }}</span>
                                            <span>Section {{ row.section is not empty ? row.section : '—' }}</span>
                                            <span>{{ row.deliveryType|replace({'_': ' '})|title }}</span>
                                        {% else %}
                                            <strong>Shared template</strong>
                                            <span>Reusable common-course baseline</span>
                                            <span>No offering submission</span>
                                        {% endif %}
                                    </td>
                                    <td class="state-cell">
                                        <span class="status-badge badge-{{ category|lower|replace({' ': '-'}) }}">{{ category }}</span>
                                        <strong>{{ row.state.value }}</strong>
                                        <span class="workflow-code">
                                            {{ row.workflowStatus ? row.workflowStatus.value|replace({'_': ' '})|title : 'No offering workflow' }}
                                        </span>
                                    </td>
                                    <td>
                                        {% if row.courseOfferingId %}
                                            {{ readiness.purpose(
                                                row.facultySubmittable,
                                                row.facultySubmissionBlockingFields,
                                                'Ready to submit',
                                                'Submission blocked'
                                            ) }}
                                        {% else %}
                                            <span class="na-text">Not applicable until an offering exists</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ readiness.purpose(
                                            row.coordinatorPublishable,
                                            row.coordinatorPublicationBlockingFields,
                                            'Ready to publish',
                                            'Publication blocked'
                                        ) }}
                                    </td>
                                    <td>
                                        {% if row.courseOfferingId %}
                                            {{ readiness.purpose(
                                                row.appendixAReady,
                                                row.appendixABlockingFields,
                                                'Report ready',
                                                'Evidence incomplete'
                                            ) }}
                                        {% else %}
                                            <span class="na-text">Requires an approved offering</span>
                                        {% endif %}
                                    </td>
                                    <td class="date-cell">
                                        {{ row.updatedAt ? row.updatedAt|date('Y-m-d H:i') : '—' }}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const selector = document.getElementById('program-selector');
            if (selector) {
                selector.addEventListener('change', function() {
                    if (this.value) {
                        const selectionUrl = "{{ path('app_program_readiness_select') }}";
                        window.location.href = selectionUrl + '?program=' + encodeURIComponent(this.value);
                    }
                });
            }
        });
    </script>
{% endautoescape %}
{% endblock %}
