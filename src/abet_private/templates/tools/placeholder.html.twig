{% extends 'base.html.twig' %}

{% block title %}{{ title }} | {% endblock %}

{% block styles %}
    <style>
        .placeholder-shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 32px 20px 56px;
        }
        .placeholder-card {
            background: #fff;
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
        }
        .placeholder-card h1 {
            margin: 0 0 14px;
            color: #8C1D40;
        }
        .placeholder-card p {
            color: #666;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="placeholder-shell">
        <div class="placeholder-card">
            <h1>{{ title }}</h1>
            <p>This tool hasn't been built out yet.</p>
        </div>
    </main>
{% endblock %}
