{% extends 'base.html.twig' %}

{% block title %}Dashboard | {% endblock %}

{% block styles %}
    <style>
        .admin-panel-grid {
            margin-top: 2rem;
        }
    </style>
{% endblock %}

{# you can override the base template with these blocks!  #}
{% block body %}
{% autoescape 'html' %}
    <link rel="stylesheet" href="assets/css/toolcards.css">
    <link rel="stylesheet" href="assets/css/checklist.css">

    <section class="hero">
        <h1>Admin Panel</h1>
        <p>Access the core tools designed to empower the Sun Devil faculty. Select a tool below to learn more about its capabilities.</p>
    </section>

    <div class="container admin-panel-grid">
        <div class="tools-grid">

            <div class="tool-card">
                <div class="card-header" onclick="triggerToggle(this)">
                    <div class="card-title">Destination Canvas Shell</div>
                    <button class="toggle-btn" aria-label="Toggle Description" type="button">+</button>
                </div>
                <div class="card-body">
                    <div class="card-body-inner">
                        <p>Manage the destination of the extraction tool.</p>
                        <a href="{{ path('app_assignments_grades') }}" class="action-link">Configure Tool 1 &rarr;</a>
                    </div>
                </div>
            </div>

            {# <?php endif; ?> #}

            {# <?php if (hasPermission($permissions, PERM_FACULTY_FORM_TOOL)): ?> #}
            <div class="tool-card">
                <div class="card-header" onclick="triggerToggle(this)">
                    <div class="card-title">User Management</div>
                    <button class="toggle-btn" aria-label="Toggle Description" type="button">+</button>
                </div>
                <div class="card-body">
                    <div class="card-body-inner">
                        <p>Manage user roles & permissions.</p>
                        <a href="{{ path('app_admin_users') }}" class="action-link">Manage Users &rarr;</a>
                    </div>
                </div>
            </div>
            {# <?php endif; ?> #}

            <div class="tool-card">
                <div class="card-header" onclick="triggerToggle(this)">
                    <div class="card-title">Permission Requests</div>
                    <button class="toggle-btn" aria-label="Toggle Description" type="button">+</button>
                </div>
                <div class="card-body">
                    <div class="card-body-inner">
                        <p>Review and approve or deny pending access requests from faculty.</p>
                        <a href="{{ path('app_admin_permission_queue') }}" class="action-link">Review Requests &rarr;</a>
                    </div>
                </div>
            </div>

            <div class="tool-card">
                <div class="card-header" onclick="triggerToggle(this)">
                    <div class="card-title">Canvas Shell Templates</div>
                    <button class="toggle-btn" aria-label="Toggle Description" type="button">+</button>
                </div>
                <div class="card-body">
                    <div class="card-body-inner">
                        <p>List current templates and draft template rows from stored Canvas course selections.</p>
                        <a href="{{ path('app_admin_templates') }}" class="action-link">Review Templates &rarr;</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        function triggerToggle(headerElement) {
            const button = headerElement.querySelector('.toggle-btn');
            const card = headerElement.closest('.tool-card');
            const content = card.querySelector('.card-body');

            const isAlreadyOpen = !!content.style.maxHeight;

            document.querySelectorAll('.card-body').forEach(el => {
                el.style.maxHeight = null;
            });
            document.querySelectorAll('.toggle-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            if (!isAlreadyOpen) {
                content.style.maxHeight = content.scrollHeight + "px";
                button.classList.add('active');
            }
        }
    </script>
{% endautoescape %}
{% endblock %}
