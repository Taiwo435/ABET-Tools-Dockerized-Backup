{% extends 'base.html.twig' %}

{% block title %}Help | {% endblock %}

{% block styles %}
    <style>
        .help-shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 32px 20px 56px;
        }
        .help-card {
            background: #fff;
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
        }
        .help-card h1 {
            margin: 0 0 14px;
            color: #8C1D40;
        }
        .help-card ul {
            margin: 14px 0 0 18px;
        }
        .help-card a {
            color: #8C1D40;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="help-shell">
        <div class="help-card">
            <h1>Help</h1>
            <ul>
                <li><a href="{{ path('app_account_help_faq') }}">FAQ</a></li>
                <li>Contact Support <em>(coming soon)</em></li>
            </ul>
        </div>
    </main>
{% endblock %}
