{% extends 'base.html.twig' %}

{% block title %}FAQ | {% endblock %}

{% block styles %}
    <style>
        .help-shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 32px 20px 56px;
        }
        .help-card {
            background: #fff;
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
        }
        .help-card h1 {
            margin: 0 0 14px;
            color: #8C1D40;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="help-shell">
        <div class="help-card">
            <h1>FAQ</h1>
            <p>FAQ placeholder.</p>
            <p><a href="{{ path('app_account_help') }}">← Back to Help</a></p>
        </div>
    </main>
{% endblock %}

