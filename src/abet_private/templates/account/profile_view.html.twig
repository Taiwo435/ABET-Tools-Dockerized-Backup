{% extends 'base.html.twig' %}

{% block title %}My Profile | {% endblock %}

{% block styles %}
    <style>
        .directory-shell {
            max-width: 900px;
            margin: 0 auto;
            padding: 32px 20px 56px;
        }

        .directory-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .directory-header {
            background-color: #8C1D40;
            color: #fff;
            padding: 2.5rem 2rem;
            border-bottom: 4px solid #FFC627;
        }

        .directory-header h1 {
            margin: 0;
            font-size: 2rem;
            font-weight: 700;
        }

        .directory-header p {
            margin: 5px 0 0;
            opacity: 0.9;
        }

        .directory-body {
            padding: 2rem;
        }

        .section-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #666;
            margin-bottom: 1.5rem;
            border-bottom: 1px solid #e8e8e8;
            padding-bottom: 10px;
            font-weight: 700;
        }

        .data-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 24px;
            margin-bottom: 2rem;
        }

        .data-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: #666;
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .data-value {
            font-size: 1.1rem;
            color: #191919;
            font-weight: 500;
            word-break: break-word;
        }

        .bio-section {
            grid-column: 1 / -1;
            background: #fafafa;
            padding: 20px;
            border-radius: 6px;
            border-left: 4px solid #e8e8e8;
        }

        .bio-text {
            line-height: 1.6;
            color: #444;
        }

        .directory-footer {
            padding: 1.5rem 2rem;
            background: #fdfdfd;
            border-top: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .last-updated {
            font-size: 0.85rem;
            color: #888;
            font-style: italic;
        }

        .action-buttons {
            display: flex;
            gap: 12px;
        }

        .btn {
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .btn-primary {
            background-color: #8C1D40;
            color: white;
            border: 1px solid #8C1D40;
        }

        .btn-secondary {
            background-color: transparent;
            color: #8C1D40;
            border: 1px solid #e8e8e8;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="directory-shell">
        <div class="directory-card">
            <div class="directory-header">
                <h1>{{ profile.display_name|default(asurite) }}</h1>
                <p>{{ email|default('No email associated') }}</p>
            </div>

            <div class="directory-body">
                <div class="section-title">Directory Information</div>

                <div class="data-grid">
                    <div>
                        <div class="data-label">ASU Username</div>
                        <div class="data-value">{{ asurite }}</div>
                    </div>

                    <div>
                        <div class="data-label">Department</div>
                        <div class="data-value">{{ profile.department|default('\u2014') }}</div>
                    </div>

                    <div>
                        <div class="data-label">Phone</div>
                        <div class="data-value">{{ profile.phone|default('\u2014') }}</div>
                    </div>

                    <div>
                        <div class="data-label">Office Location</div>
                        <div class="data-value">{{ profile.office_location|default('\u2014') }}</div>
                    </div>

                    <div class="bio-section">
                        <div class="data-label">Professional Bio</div>
                        <div class="data-value bio-text">{{ profile.bio|default('No biography available.')|nl2br }}</div>
                    </div>
                </div>
            </div>

            <div class="directory-footer">
                <div class="last-updated">
                    Last synced: {{ profile.updated_at|default('Never') }}
                </div>

                <div class="action-buttons">
                    <a class="btn btn-secondary" href="{{ path('app_account_settings') }}">Account Settings</a>
                    <a class="btn btn-primary" href="{{ path('app_account_profile') }}">Edit Profile</a>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
