{% extends 'base.html.twig' %}

{% block title %}Account Settings | {% endblock %}

{% block styles %}
    <style>
        .settings-shell {
            max-width: 760px;
            margin: 0 auto;
            padding: 32px 20px 56px;
        }
        .settings-card {
            background: #fff;
            border-radius: 8px;
            padding: 24px;
            box-shadow: 0 8px 24px rgba(0,0,0,.08);
        }
        .settings-card h1 {
            margin: 0 0 14px;
            color: #8C1D40;
        }
        .settings-card ul {
            margin: 14px 0 0 18px;
        }
        .settings-card a {
            color: #8C1D40;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="settings-shell">
        <div class="settings-card">
            <h1>Account Settings</h1>
            <ul>
                {# email/sessions are unimplemented stubs, same as legacy #}
                <li><a href="/account/settings/email/">Change Email</a></li>
                <li><a href="{{ path('app_account_settings_password') }}">Reset Password</a></li>
                <li><a href="/account/settings/sessions/">Manage Sessions</a></li>
            </ul>
        </div>
    </main>
{% endblock %}
