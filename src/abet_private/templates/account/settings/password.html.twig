{% extends 'base.html.twig' %}

{% block title %}Reset Password | {% endblock %}

{% block styles %}
    <style>
        .password-shell {
            max-width: 720px;
            margin: 0 auto;
            padding: 32px 20px 56px;
        }
        .password-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
            overflow: hidden;
        }
        .password-header {
            padding: 22px 24px;
            background: linear-gradient(135deg, #8C1D40, #5c132a);
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .password-body {
            padding: 24px;
        }
        .alert {
            padding: 12px 14px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 0.95rem;
        }
        .alert-error {
            background: #fdedf0;
            color: #8C1D40;
            border-left: 4px solid #8C1D40;
        }
        .alert-success {
            background: #ecfdf3;
            color: #0f5132;
            border-left: 4px solid #198754;
        }
        label {
            display: block;
            font-weight: 700;
            margin: 14px 0 8px;
        }
        input[type="password"] {
            width: 100%;
            padding: 14px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 1rem;
        }
        .actions {
            margin-top: 18px;
            display: flex;
            gap: 12px;
        }
        .btn {
            border: none;
            border-radius: 10px;
            padding: 12px 16px;
            font-weight: 800;
            cursor: pointer;
        }
        .btn-primary {
            background: #8C1D40;
            color: #fff;
        }
        .btn-secondary {
            background: #eee;
            color: #333;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="password-shell">
        <div class="password-card">
            <div class="password-header">
                <h1>Reset Password</h1>
                <a href="{{ path('app_account_settings') }}" style="color:#fff;">← Back</a>
            </div>
            <div class="password-body">
                {% for message in app.flashes('error') %}
                    <div class="alert alert-error">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}

                <form method="post" action="{{ path('app_account_settings_password_update') }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('settings_password') }}">

                    <label for="current_password">Current Password</label>
                    <input id="current_password" name="current_password" type="password" required>

                    <label for="new_password">New Password</label>
                    <input id="new_password" name="new_password" type="password" required>

                    <label for="confirm_password">Confirm New Password</label>
                    <input id="confirm_password" name="confirm_password" type="password" required>

                    <div class="actions">
                        <button class="btn btn-primary" type="submit">Update Password</button>
                        <a class="btn btn-secondary" href="{{ path('app_account_settings') }}">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </main>
{% endblock %}	
