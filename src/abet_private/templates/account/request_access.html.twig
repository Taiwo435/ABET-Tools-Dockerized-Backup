{% extends 'base.html.twig' %}

{% block title %}Request Access | {% endblock %}

{% block styles %}
    <style>
        .request-shell {
            max-width: 640px;
            margin: 0 auto;
            padding: 32px 20px 56px;
        }

        .request-header {
            margin-bottom: 24px;
        }

        .request-header h1 {
            margin: 0 0 8px;
            font-size: 2rem;
            line-height: 1.2;
        }

        .request-header p {
            max-width: 560px;
            margin: 0;
            color: #565656;
            line-height: 1.55;
        }

        .request-form {
            border: 1px solid #d5d5d5;
            border-radius: 8px;
            padding: 20px;
            background: #fff;
        }

        .permission-option {
            display: block;
            font-weight: normal;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .permission-option:last-of-type {
            border-bottom: none;
        }

        .msg {
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .msg.success {
            background: #d8f0df;
            color: #155b2d;
        }

        .msg.pending {
            background: #fff4d6;
            color: #7a5b00;
        }
    </style>
{% endblock %}

{% block body %}
    <main class="request-shell">
        <div class="request-header">
            <h1>Request Access</h1>
            <p>Select the tools you need access to. An admin will review your request and approve or deny it.</p>
        </div>

        {% if submitted %}
            <div class="msg success">
                <strong>Request submitted.</strong> An admin will review it shortly.
            </div>
        {% endif %}

        {% if pendingPermissions|length > 0 %}
            <div class="msg pending">
                You have a pending request for: {{ pendingPermissions|join(', ')|replace({'_': ' '}) }}
            </div>
        {% endif %}

        <form class="request-form" method="post" action="{{ path('app_account_request_access') }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token('request_access') }}">

            {% for permission in requestablePermissions %}
                <label class="permission-option">
                    <input type="checkbox" name="permissions[]" value="{{ permission.name }}"
                        {{ permission.name in pendingPermissions ? 'checked' : '' }}>
                    {{ permission.name|replace({'_': ' '})|title }}
                    {% if permission.name in currentPermissions %}
                        <em>(already granted)</em>
                    {% endif %}
                </label>
            {% endfor %}

            <button type="submit" class="btn btn-secondary" style="margin-top: 16px;">Submit Request</button>
        </form>
    </main>
{% endblock %}
