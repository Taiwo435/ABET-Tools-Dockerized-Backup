# General

APP_VERSION=0.1.0
APP_NAME="ABET Tools"
APP_DEBUG=true
APP_KEY=base64:QdC427uTFzYAqD1GZzl/crKR1Njnv8YL9/Q+2GUPNzU=
APP_URL=http://localhost:8000
APP_LOCALE=en
# used by docker
BUILD_ENV="development" 		# development or production
# used by symfony
APP_ENV="dev" 		# dev or prod

# ABET Private directory (for storing sensitive data like database credentials, API keys, etc.)

ABET_PRIVATE_DIR=/home/src/abet_private
# prod is /home/osburn/abet_docker/src

# openai related

OPENAI_API_KEY=NOT_SECURE_CHANGE_ME

#######################
# Container-specific
#######################
# App here references 

WEBSERVER_HOSTNAME="php_apache"		# need to migrate to HOSTNAME
WEBSERVER_PORT=8080

# mysql related

MYSQL_HOSTNAME=mysql
MYSQL_ROOT_PASSWORD=notSecureChangeMe
MYSQL_DATABASE=osburn_abet_tools_dev
