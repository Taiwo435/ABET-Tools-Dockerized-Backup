# General

APP_NAME = ABET Tools
APP_ENV = local
APP_DEBUG = true
APP_CONTAINERNAME = php_apache
BUILD_ENV = development # development or production

ABET_PRIVATE_DIR = /home/abet_private

# mysql related

MYSQL_ROOT_PASSWORD = notSecureChangeMe
