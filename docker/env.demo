####################################################
# Application Environment Variables
# 
# Will act as a global configuration file that stores
# sensitive login information. 
#
# Danny Hoang
####################################################

# General

APP_VERSION = 0.1.0
APP_NAME = ABET Tools
BUILD_ENV = development 		# development or production
APP_DEBUG = true

# ABET Private directory (for storing sensitive data like database credentials, API keys, etc.)

ABET_PRIVATE_DIR = /home/abet_private

# openai related

OPENAI_API_KEY = notSecureChangeMe

#######################
# Container-specific
#######################
# App here references 

APP_CONTAINERNAME = php_apache
WEBSERVER_HOSTNAME = php_apache		# need to migrate to HOSTNAME
APP_PORT = 8080


# mysql related

MYSQL_HOSTNAME = mysql
MYSQL_ROOT_PASSWORD = notSecureChangeMe
MYSQL_DATABASE = abet_tools
MYSQL_USER = abet_user
MYSQL_PASS = notSecureChangeMe

# extraction_api

EXTRACTION_HOSTNAME = extraction_api
EXTRACTION_PORT = 8000


# testing

SELENIUM_HOSTNAME = selenium
SELENIUM_PORT = 4444

